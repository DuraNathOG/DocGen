                                            fill="currentColor"
                                            stroke="none"
                                        />
                                        <rect
                                            x="4"
                                            y="10.5"
                                            width="16"
                                            height="2.5"
                                            rx="1.2"
                                            fill="currentColor"
                                            stroke="none"
                                        />
                                        <rect
                                            x="4"
                                            y="16.5"
