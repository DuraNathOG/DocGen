                                </svg>
                                <div class="mk-group">
                                    <button
                                        class="mk-btn"
                                        type="button"
                                        data-tool="select"
                                        data-tip="Select (V)"
                                        aria-label="Select"
                                        aria-pressed="false"
                                    >
                                        <svg class="mk-icon" aria-hidden="true"><use href="#dgi-pointer"></use></svg>
                                    </button>
                                    <button
                                        class="mk-btn"
                                        type="button"
                                        data-tool="pan"
                                        data-tip="Pan (H)"
                                        aria-label="Pan"
                                        aria-pressed="false"
                                    >
                                        <svg class="mk-icon" aria-hidden="true"><use href="#dgi-hand-stop"></use></svg>
                                    </button>
                                </div>
                                <div class="mk-group">
                                    <button
                                        class="mk-btn"
                                        type="button"
                                        data-tool="pen"
                                        data-tip="Pen (P)"
                                        aria-label="Pen"
                                        aria-pressed="false"
                                    >
                                        <svg class="mk-icon" aria-hidden="true"><use href="#dgi-pencil"></use></svg>
                                    </button>
                                    <button
                                        class="mk-btn"
                                        type="button"
                                        data-tool="highlight"
                                        data-tip="Highlighter (U)"
                                        aria-label="Highlighter"
                                        aria-pressed="false"
                                    >
                                        <svg class="mk-icon" aria-hidden="true"><use href="#dgi-highlight"></use></svg>
                                    </button>
                                    <button
                                        id="mk-shapes"
                                        class="mk-btn"
                                        type="button"
                                        data-menu="mk-shapes-menu"
                                        data-tip="Shapes (R, O, L)"
                                        aria-label="Shapes"
                                        aria-haspopup="true"
                                        aria-expanded="false"
                                    >
                                        <svg id="mk-shapes-icon" class="mk-icon" aria-hidden="true">
                                            <use href="#dgi-square"></use></svg
                                        ><svg class="mk-icon mk-chev" aria-hidden="true">
                                            <use href="#dgi-chevron-down"></use>
                                        </svg>
                                    </button>
                                    <div id="mk-shapes-menu" class="mk-menu" style="display: none" role="menu">
                                        <button class="mk-item" type="button" role="menuitem" data-tool="rect">
                                            <svg class="mk-icon" aria-hidden="true"><use href="#dgi-square"></use></svg
                                            >Rectangle<span class="mk-kbd">R</span>
                                        </button>
                                        <button class="mk-item" type="button" role="menuitem" data-tool="ellipse">
                                            <svg class="mk-icon" aria-hidden="true"><use href="#dgi-circle"></use></svg
                                            >Ellipse<span class="mk-kbd">O</span>
                                        </button>
                                        <button class="mk-item" type="button" role="menuitem" data-tool="line">
                                            <svg class="mk-icon" aria-hidden="true"><use href="#dgi-line"></use></svg
                                            >Line<span class="mk-kbd">L</span>
                                        </button>
                                    </div>
                                    <button
                                        class="mk-btn"
                                        type="button"
                                        data-tool="arrow"
                                        data-tip="Arrow (A)"
                                        aria-label="Arrow"
                                        aria-pressed="false"
                                    >
                                        <svg class="mk-icon" aria-hidden="true">
                                            <use href="#dgi-arrow-up-right"></use>
                                        </svg>
                                    </button>
                                    <button
                                        class="mk-btn"
                                        type="button"
                                        data-tool="cloud"
                                        data-tip="Revision cloud (C)"
                                        aria-label="Revision cloud"
                                        aria-pressed="false"
                                    >
                                        <svg class="mk-icon" aria-hidden="true"><use href="#dgi-cloud"></use></svg>
                                    </button>
                                    <button
                                        class="mk-btn"
                                        type="button"
                                        data-tool="text"
                                        data-tip="Text (T): Enter for a new line"
