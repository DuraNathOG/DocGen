                                if (j && j.ip) capturedIp = j.ip;
                            })
                            .catch(function () {
                                /* fallback to server-side capture */
                            });
                    } catch (e) {
                        /* fetch unavailable — fall back to server-side capture */
                    }

                    // ===== STEP 1: VALIDATE TOKEN =====
                    Visualforce.remoting.Manager.invokeAction(
                        '{!$RemoteAction.DocGenSignatureController.validateToken}',
                        token,
                        function (result, event) {
                            if (event.status && result && result.isValid) {
                                signerData = result;
                                if (result.requiresPin) {
                                    initVerifyScreen(result);
                                    // #verification — pre-fill: skip the "type your email" step and
                                    // auto-send the code to the signer's known address. The code
                                    // still goes only to the real inbox.
                                    if (result.prefillEmail && result.signerEmail) {
                                        var pfEmail = document.getElementById('verify-email');
                                        if (pfEmail) {
                                            pfEmail.value = result.signerEmail;
                                        }
                                        handleSendPin();
                                    }
                                } else {
                                    initAfterVerification(result);
                                }
                            } else {
                                showError(
                                    result && result.errorMessage
                                        ? result.errorMessage
                                        : 'This signature request is no longer active.'
                                );
                            }
                        },
                        { escape: false }
                    );

                    // ===== EMAIL VERIFICATION (PIN) =====
                    function initVerifyScreen(data) {
                        document.getElementById('verify-doc-title').textContent =
                            data.documentTitle || 'Document Signature';
                        if (data.signerEmail) {
                            var parts = data.signerEmail.split('@');
                            document.getElementById('verify-email').placeholder =
                                'Enter: ' + parts[0].substring(0, 2) + '***@' + parts[1];
                        }
                        showState('verify');
                        document.getElementById('btn-send-pin').addEventListener('click', handleSendPin);
                        document.getElementById('btn-verify-pin').addEventListener('click', handleVerifyPin);
                        document.getElementById('resend-link').addEventListener('click', handleResendPin);
                        document.getElementById('verify-pin').addEventListener('keydown', function (e) {
                            if (e.key === 'Enter') handleVerifyPin();
                        });
                        document.getElementById('verify-email').addEventListener('keydown', function (e) {
                            if (e.key === 'Enter') handleSendPin();
                        });
                    }

                    function handleSendPin() {
                        var email = document.getElementById('verify-email').value.trim();
                        if (!email) {
                            showVerifyMsg('Please enter your email address.', 'error');
                            return;
                        }
                        var btn = document.getElementById('btn-send-pin');
                        btn.disabled = true;
                        btn.textContent = 'Sending...';
                        Visualforce.remoting.Manager.invokeAction(
                            '{!$RemoteAction.DocGenSignatureController.sendPin}',
                            token,
                            email,
                            function (result, event) {
                                btn.disabled = false;
                                btn.textContent = 'Send Verification Code';
                                if (event.status && result && result.success) {
                                    showVerifyMsg(result.message, 'success');
                                    document.getElementById('pin-section').style.display = '';
                                    btn.style.display = 'none';
                                    startResendTimer();
                                } else {
                                    showVerifyMsg(
                                        result ? result.message : 'Failed to send verification code.',
                                        'error'
                                    );
                                }
                            },
                            { escape: false }
                        );
                    }

                    function handleVerifyPin() {
                        var pin = document.getElementById('verify-pin').value.trim();
                        if (!pin || pin.length !== 6) {
                            showVerifyMsg('Please enter the 6-digit code from your email.', 'error');
                            return;
                        }
                        var btn = document.getElementById('btn-verify-pin');
                        btn.disabled = true;
                        btn.textContent = 'Verifying...';
                        Visualforce.remoting.Manager.invokeAction(
                            '{!$RemoteAction.DocGenSignatureController.verifyPin}',
                            token,
                            pin,
                            function (result, event) {
                                btn.disabled = false;
                                btn.textContent = 'Verify';
                                if (event.status && result && result.success) {
                                    initAfterVerification(signerData);
                                } else {
                                    showVerifyMsg(result ? result.message : 'Verification failed.', 'error');
                                }
                            },
                            { escape: false }
                        );
                    }

                    function handleResendPin() {
                        if (document.getElementById('resend-link').classList.contains('disabled')) return;
                        var email = document.getElementById('verify-email').value.trim();
                        Visualforce.remoting.Manager.invokeAction(
                            '{!$RemoteAction.DocGenSignatureController.sendPin}',
                            token,
                            email,
                            function (result, event) {
                                if (event.status && result && result.success) {
                                    showVerifyMsg('New verification code sent.', 'success');
                                    startResendTimer();
                                } else {
                                    showVerifyMsg(result ? result.message : 'Failed to resend code.', 'error');
                                }
                            },
                            { escape: false }
                        );
                    }

                    function startResendTimer() {
                        var link = document.getElementById('resend-link');
                        link.classList.add('disabled');
                        var seconds = 60;
                        link.textContent = 'Resend code (' + seconds + 's)';
                        if (resendTimer) clearInterval(resendTimer);
                        resendTimer = setInterval(function () {
                            seconds--;
                            if (seconds <= 0) {
                                clearInterval(resendTimer);
                                link.classList.remove('disabled');
                                link.textContent = 'Resend code';
                            } else {
                                link.textContent = 'Resend code (' + seconds + 's)';
                            }
                        }, 1000);
                    }

                    // ===== AFTER VERIFICATION: SHOW PDF =====
                    function initAfterVerification(data) {
                        isMultiSigner = data.isSignerToken === true;

                        document.getElementById('pdf-doc-title').textContent =
                            data.documentTitle || 'Document Signature';
                        document.getElementById('pdf-signer-name').textContent = data.signerName || '';
                        if (data.roleName) {
                            var badge = document.getElementById('pdf-role-badge');
                            badge.textContent = data.roleName;
                            badge.style.display = 'inline-block';
                        }
                        if (isMultiSigner) {
                            var progressEl = document.getElementById('pdf-progress-info');
                            progressEl.textContent =
                                ' (Signer ' + ((data.signedCount || 0) + 1) + ' of ' + (data.totalSigners || 1) + ')';
                            progressEl.style.display = 'inline';
                        }

                        showState('pdf');

                        // Wire the action bar.
                        document.getElementById('btn-open-sign').addEventListener('click', openSignModal);
                        // #367 — Decline shows by default. The server sets
                        // showDecline=false only when an admin turned on "Hide Decline
                        // Button" org-wide or on this request's template; the gate is
                        // re-enforced in declineSignature so hiding it can't be bypassed.
                        if (!data || !data.showDecline) {
                            document.getElementById('btn-decline').style.display = 'none';
                        }
                        document.getElementById('btn-decline').addEventListener('click', function () {
                            // #412 M2 — say what happens to the signer's markups.
                            var note = document.getElementById('decline-markup-note');
                            var n = markupMode !== 'Off' ? markedUpCount() : 0;
                            note.style.display = n ? '' : 'none';
                            note.textContent = n
                                ? 'Your markups on ' +
                                  n +
                                  (n === 1 ? ' document' : ' documents') +
                                  ' will be saved to the record with your decline.'
                                : '';
                            showDeclineReview();
                            showState('decline');
                        });
                        document.getElementById('btn-decline-cancel').addEventListener('click', function () {
                            showState('pdf');
                        });
                        document.getElementById('btn-decline-review').addEventListener('click', function () {
                            showState('pdf');
                            var remaining = unopenedAttachments();
                            if (remaining.length) showDocument(remaining[0]);
                        });
                        document.getElementById('btn-decline-confirm').addEventListener('click', handleDecline);

                        // Wire the modal.
                        wireSignModal();

                        // #412 — attached documents (if any) load alongside the signing document.
                        initAttachments(data);

                        // Load and render the real PDF through the viewer abstraction.
                        loadPdf();
                    }

                    // ===== PDF LOAD + RENDER (via DocGenPdfViewer) =====
                    function loadPdf() {
                        var containerEl = document.getElementById('pdf-viewer-container');
                        Visualforce.remoting.Manager.invokeAction(
                            '{!$RemoteAction.DocGenSignatureController.getSourcePdfBase64}',
                            token,
                            function (result, event) {
                                if (event.status && result && result.base64) {
                                    // Keep the bytes for client-side compositing at finish.
                                    sourcePdfBase64 = result.base64;
                                    // The viewer module owns rendering — the page never touches
                                    // blobs/iframes/PDF.js directly. Once painted, try to set up
                                    // the guided sign-spot overlay (no-op when there are no
                                    // placements — the single-modal flow stays in effect).
                                    DocGenPdfViewer.render(result.base64, containerEl)
                                        .then(function () {
                                            formRendered.resolve();
                                            initGuidedOverlay();
                                        })
                                        .catch(function () {
                                            /* render error already shown by the viewer */
                                        });
                                } else {
                                    DocGenPdfViewer.render(null, containerEl);
                                }
                            },
                            { escape: false, buffer: false, timeout: 120000 }
                        );
                    }

                    // ===== #412 ATTACHED DOCUMENTS =====
                    // Existing PDFs from the record (e.g. engineering drawings), shown alongside the
                    // signing document one at a time and fetched by index from the guest REST
                    // endpoint as raw bytes — drawings run past what remoting can carry. The signer
                    // must open every one before signing; saveCompositedSignedPdf enforces the same
                    // rule server-side, so this UI gate is a convenience, not the control.
                    var attachments = null; // [{index,title,version,size,position,sha256,viewedAt}]
                    var attachmentEndpoint = null;
                    var docOrder = []; // display order: 'form' and attachment entries
                    var currentDoc = 'form';
                    var attachmentLoadGen = 0;
                    var attachmentCache = []; // [{index, bytes}], most recent last
                    // #412 M2 — markup. markupBytes[index] is this signer's marked-up copy (the
                    // original plus their annotations), captured when they leave the document;
                    // markupUploaded[index] once that copy is saved to the record.
                    var markupMode = 'Off'; // Off / Decline only / Approve or decline
                    var markupBytes = {};
                    var markupUploaded = {};
                    var shownDoc = null; // the attachment the viewer is showing (null while loading)
                    var ATTACHMENT_CACHE_BYTES = 48 * 1024 * 1024;
                    var formRendered = (function () {
                        var done;
                        var p = new Promise(function (resolve) {
                            done = resolve;
                        });
                        return { promise: p, resolve: done };
                    })();

                    function hasAttachments() {
                        return !!(attachments && attachments.length);
                    }

                    function unopenedAttachments() {
                        var left = [];
                        for (var i = 0; attachments && i < attachments.length; i++) {
                            if (!attachments[i].viewedAt) left.push(attachments[i]);
                        }
                        return left;
                    }

                    function formatBytes(n) {
                        if (!n) return '';
                        if (n < 1024 * 1024) return Math.max(1, Math.round(n / 1024)) + ' KB';
                        return (n / (1024 * 1024)).toFixed(1) + ' MB';
                    }

                    function initAttachments(data) {
                        if (!data || !data.attachmentCount) return;
                        var manifest = new Promise(function (resolve, reject) {
                            Visualforce.remoting.Manager.invokeAction(
                                '{!$RemoteAction.DocGenSignatureController.getAttachmentManifest}',
                                token,
                                function (result, event) {
                                    if (event.status && result && result.success) {
                                        resolve(result);
                                    } else {
                                        reject(
                                            new Error(
                                                (result && result.message) ||
                                                    'The attached documents could not be loaded.'
                                            )
                                        );
                                    }
                                },
                                { escape: false }
                            );
                        });
                        manifest
                            .then(function (result) {
                                attachments = result.attachments || [];
                                attachmentEndpoint = result.endpoint;
                                markupMode = result.markup || 'Off';
                                wireMarkup();
                                if (!attachments.length) return;
                                var before = [];
                                var after = [];
                                attachments.forEach(function (a) {
                                    (a.position === 'After' ? after : before).push(a);
                                });
                                docOrder = before.concat(['form'], after);
                                buildDocNav();
                                refreshAttachmentStatus();
                                refreshGuidedStatus();
                                // The signing document lays itself out against a visible viewer,
                                // so only switch away once it has rendered.
                                if (docOrder[0] !== 'form') {
                                    formRendered.promise.then(function () {
                                        if (currentDoc === 'form') showDocument(docOrder[0]);
                                    });
                                }
                            })
                            .catch(function (err) {
                                showError(
                                    (err && err.message ? err.message : 'The attached documents could not be loaded.') +
                                        ' Please refresh the page, or contact the sender.'
                                );
                            });
                    }

                    function docTitle(entry) {
                        if (entry === 'form') {
                            return signerData && signerData.documentTitle ? signerData.documentTitle : 'Document';
                        }
                        return (entry.title || 'Document') + (entry.version ? ' (v' + entry.version + ')' : '');
                    }

                    // The tab's tooltip and accessible name: the full title and where the signer is with it.
                    function docLabel(entry) {
                        if (entry === 'form') return docTitle(entry) + ': sign here';
                        var pos = attachments.indexOf(entry) + 1;
                        return (
                            'Attached document ' +
                            pos +
                            ' of ' +
                            attachments.length +
                            ': ' +
                            docTitle(entry) +
                            (entry.viewedAt ? ', opened' : ', not opened yet') +
                            (isMarkedUp(entry) ? ', marked up' : '')
                        );
                    }

                    function svgIcon(id, className) {
                        var ns = 'http://www.w3.org/2000/svg';
                        var svg = document.createElementNS(ns, 'svg');
                        svg.setAttribute('class', className || 'dt-icon');
                        svg.setAttribute('aria-hidden', 'true');
                        var use = document.createElementNS(ns, 'use');
                        use.setAttribute('href', '#' + id);
                        svg.appendChild(use);
                        return svg;
                    }

                    function buildDocNav() {
                        var tabs = document.getElementById('doc-tabs');
                        while (tabs.firstChild) tabs.removeChild(tabs.firstChild);
                        docOrder.forEach(function (entry, i) {
                            var tab = document.createElement('button');
                            tab.type = 'button';
                            tab.setAttribute('role', 'tab');
                            tab.addEventListener('click', function () {
                                showDocument(docOrder[i]);
                            });
                            tabs.appendChild(tab);
                        });
                        // Arrow keys move between tabs, as in any tab strip.
                        tabs.addEventListener('keydown', function (e) {
                            if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
                            e.preventDefault();
                            var to = docOrder.indexOf(currentDoc) + (e.key === 'ArrowLeft' ? -1 : 1);
                            if (to < 0 || to >= docOrder.length) return;
                            tabs.children[to].focus();
                            showDocument(docOrder[to]);
                        });
                        document.getElementById('doc-prev').addEventListener('click', function () {
                            stepDocument(-1);
                        });
                        document.getElementById('doc-next').addEventListener('click', function () {
                            stepDocument(1);
                        });
                        document.getElementById('att-zoom-in').addEventListener('click', function () {
                            stepZoom(1);
                        });
                        document.getElementById('att-zoom-out').addEventListener('click', function () {
                            stepZoom(-1);
                        });
                        document.getElementById('att-zoom-fit').addEventListener('click', function () {
                            DocGenAttachmentViewer.fit();
                        });
                        document.getElementById('doc-nav').style.display = '';
                        document.getElementById('doc-status').style.display = '';
                        syncDocNav();
                    }

                    function syncDocNav() {
                        var tabs = document.getElementById('doc-tabs');
                        var at = docOrder.indexOf(currentDoc);
                        docOrder.forEach(function (entry, i) {
                            var tab = tabs.children[i];
                            if (!tab) return;
                            var form = entry === 'form';
                            var active = i === at;
                            tab.className =
                                'doc-tab' +
                                (form ? ' form' : entry.viewedAt ? ' opened' : ' unopened') +
                                (active ? ' active' : '');
                            tab.setAttribute('aria-selected', active ? 'true' : 'false');
                            tab.tabIndex = active ? 0 : -1;
                            tab.title = docLabel(entry);
                            tab.setAttribute('aria-label', docLabel(entry));
                            while (tab.firstChild) tab.removeChild(tab.firstChild);
                            tab.appendChild(
                                svgIcon(
                                    form ? 'dgi-signature' : entry.viewedAt ? 'dgi-circle-check' : 'dgi-circle-dashed'
                                )
                            );
                            var label = document.createElement('span');
                            label.className = 'dt-label';
                            label.textContent = docTitle(entry);
                            tab.appendChild(label);
                            if (form) {
                                var sign = document.createElement('span');
                                sign.className = 'dt-sign';
                                sign.textContent = 'Sign here';
                                tab.appendChild(sign);
                            } else if (isMarkedUp(entry)) {
                                var mark = document.createElement('span');
                                mark.className = 'dt-mark';
                                mark.textContent = '✎';
                                tab.appendChild(mark);
                            }
                        });
                        // Keep the open document's tab in view, without moving the page.
                        var current = tabs.children[at];
                        if (current) {
                            var left = current.offsetLeft - tabs.offsetLeft;
                            if (
                                left < tabs.scrollLeft ||
                                left + current.offsetWidth > tabs.scrollLeft + tabs.clientWidth
                            ) {
                                tabs.scrollLeft = Math.max(0, left - (tabs.clientWidth - current.offsetWidth) / 2);
                            }
                        }
                        document.getElementById('doc-prev').disabled = at <= 0;
                        document.getElementById('doc-next').disabled = at >= docOrder.length - 1;
                    }

                    function stepDocument(delta) {
                        var at = docOrder.indexOf(currentDoc) + delta;
                        if (at >= 0 && at < docOrder.length) showDocument(docOrder[at]);
                    }

                    // The banner: how many attached documents are left to open, with a button to the
                    // next one, until all are; then a slim line saying so.
                    function refreshAttachmentStatus() {
                        if (!hasAttachments()) return;
                        var el = document.getElementById('doc-status');
                        while (el.firstChild) el.removeChild(el.firstChild);
                        var left = unopenedAttachments();
                        var total = attachments.length;
                        if (!left.length) {
                            el.className = 'doc-banner complete';
                            el.appendChild(svgIcon('dgi-circle-check'));
                            el.appendChild(
                                document.createTextNode(
                                    total === 1
                                        ? 'The attached document has been opened.'
                                        : 'All ' + total + ' attached documents have been opened.'
                                )
                            );
                            return;
                        }
                        el.className = 'doc-banner';
                        var icon = document.createElement('span');
                        icon.className = 'db-icon';
                        icon.appendChild(svgIcon('dgi-files'));
                        el.appendChild(icon);
                        var text = document.createElement('div');
                        text.className = 'db-text';
                        var head = document.createElement('strong');
                        head.textContent =
                            total === 1
                                ? 'There is 1 attached document to review'
                                : left.length === total
                                  ? 'There are ' + total + ' attached documents to review'
                                  : left.length + ' of ' + total + ' attached documents still to review';
                        text.appendChild(head);
                        text.appendChild(
                            document.createTextNode(
                                (total === 1 ? 'Open it' : 'Open each one') + ' before you sign or decline.'
                            )
                        );
                        var more = document.createElement('span');
                        more.className = 'db-more';
                        more.textContent = ' Use the tabs below to move between them.';
                        text.appendChild(more);
                        el.appendChild(text);
                        var next = document.createElement('button');
                        next.type = 'button';
                        next.className = 'btn btn-brand';
                        next.textContent = left.length === total ? 'Open the first one' : 'Open the next one';
                        next.addEventListener('click', function () {
                            var remaining = unopenedAttachments();
                            if (remaining.length) showDocument(remaining[0]);
                        });
                        el.appendChild(next);
                    }

                    function showDocument(entry) {
                        if (docOrder.indexOf(entry) < 0) return;
                        captureMarks()
                            .catch(function (err) {
                                console.error('Portwood: could not keep the markups on this document', err);
                            })
                            .then(function () {
                                switchDocument(entry);
                            });
                    }

                    function switchDocument(entry) {
                        currentDoc = entry;
                        var formEl = document.getElementById('pdf-viewer-container');
                        var pane = document.getElementById('attachment-pane');
                        var attEl = document.getElementById('attachment-viewer-container');
                        syncDocNav();
                        if (entry === 'form') {
                            attachmentLoadGen++;
                            shownDoc = null;
                            DocGenAttachmentViewer.release(attEl);
                            pane.style.display = 'none';
                            formEl.style.display = '';
                            return;
                        }
                        formEl.style.display = 'none';
                        pane.style.display = '';
                        loadAttachment(entry);
                    }

                    function setAttachmentMeta(a, pageCount) {
                        var bits = [a.title || 'Document'];
                        if (a.version) bits.push('v' + a.version);
                        if (a.size) bits.push(formatBytes(a.size));
                        if (pageCount) bits.push(pageCount + (pageCount === 1 ? ' page' : ' pages'));
                        document.getElementById('attachment-meta').textContent = bits.join(' \u00B7 ');
                    }

                    // Zoom controls mirror the viewer: the label reads the zoom relative to
                    // fit-to-width and doubles as the "Fit" button.
                    function syncZoomControls() {
                        var z = DocGenAttachmentViewer.state();
                        var label = document.getElementById('att-zoom-fit');
                        label.textContent = !z.ready || z.fit ? 'Fit' : z.percent + '%';
                        label.disabled = !z.ready || z.fit;
                        document.getElementById('att-zoom-out').disabled = !z.ready || !z.canZoomOut;
                        document.getElementById('att-zoom-in').disabled = !z.ready || !z.canZoomIn;
                        syncMarkupBar(z);
                    }

                    function stepZoom(delta) {
                        if (delta > 0) {
                            DocGenAttachmentViewer.zoomIn();
                        } else {
                            DocGenAttachmentViewer.zoomOut();
                        }
                    }

                    function showAttachmentMessage(text, isError, withProgress, retry) {
                        var el = document.getElementById('attachment-viewer-container');
                        DocGenAttachmentViewer.release(el);
                        var box = document.createElement('div');
                        box.className = 'attachment-message' + (isError ? ' error' : '');
                        var p = document.createElement('p');
                        p.textContent = text;
                        box.appendChild(p);
                        var bar = null;
                        if (withProgress) {
                            var track = document.createElement('div');
                            track.className = 'attachment-progress';
                            bar = document.createElement('span');
                            track.appendChild(bar);
                            box.appendChild(track);
                        }
                        if (retry) {
                            var btn = document.createElement('button');
                            btn.type = 'button';
                            btn.className = 'btn';
                            btn.style.marginTop = '1rem';
                            btn.textContent = 'Try again';
                            btn.addEventListener('click', retry);
                            box.appendChild(btn);
                        }
                        el.appendChild(box);
                        return bar;
                    }

                    function loadAttachment(a) {
                        var gen = ++attachmentLoadGen;
                        shownDoc = null;
                        var el = document.getElementById('attachment-viewer-container');
                        setAttachmentMeta(a);
                        DocGenAttachmentViewer.release();
                        syncZoomControls();
                        var bar = showAttachmentMessage(
                            'Loading ' +
                                (a.title || 'document') +
                                (a.size ? ' (' + formatBytes(a.size) + ')' : '') +
                                '\u2026',
                            false,
                            true
                        );
                        var onProgress = function (loaded, total) {
                            if (bar && total) bar.style.width = Math.min(100, Math.round((loaded / total) * 100)) + '%';
                        };
                        // #412 M2 — the signer's marked-up copy when there is one: in this session's
                        // memory, or saved earlier (e.g. before a reload), so new marks build on it.
                        var source = markupBytes[a.index]
                            ? Promise.resolve(markupBytes[a.index])
                            : a.markedUpAt && markupMode !== 'Off'
                              ? fetchSavedMarkup(a, onProgress)
                              : fetchAttachmentBytes(a, onProgress);
                        source
                            .then(function (bytes) {
                                if (gen !== attachmentLoadGen) return null;
                                return DocGenAttachmentViewer.render(
                                    bytes,
                                    el,
                                    function (pageCount) {
                                        if (gen !== attachmentLoadGen) return;
                                        shownDoc = a;
                                        setAttachmentMeta(a, pageCount);
                                        recordAttachmentOpened(a, 0);
                                        syncDocNav();
                                    },
                                    syncZoomControls,
                                    { markup: markupMode !== 'Off' }
                                );
                            })
                            .then(function () {
                                if (gen === attachmentLoadGen) syncZoomControls();
                            })
                            .catch(function (err) {
                                if (gen !== attachmentLoadGen) return;
                                console.error('Portwood attached document ' + a.index + ' failed', err);
                                showAttachmentMessage(
                                    err && err.userMessage
                                        ? err.userMessage
                                        : 'This document could not be displayed. Check your connection and try again.',
                                    true,
                                    false,
                                    function () {
                                        loadAttachment(a);
                                    }
                                );
                            });
                    }

                    function userError(message) {
                        var e = new Error(message);
                        e.userMessage = message;
                        return e;
                    }

                    function cachedAttachment(index) {
                        for (var i = 0; i < attachmentCache.length; i++) {
                            if (attachmentCache[i].index === index) return attachmentCache[i].bytes;
                        }
                        return null;
                    }

                    function cacheAttachment(index, bytes) {
                        attachmentCache.push({ index: index, bytes: bytes });
                        var total = 0;
                        for (var i = 0; i < attachmentCache.length; i++) total += attachmentCache[i].bytes.length;
                        while (attachmentCache.length > 1 && total > ATTACHMENT_CACHE_BYTES) {
                            total -= attachmentCache.shift().bytes.length;
                        }
                    }

                    // Raw PDF bytes for one attachment. The token travels in a header (never the
                    // URL); the response is checked against the server's SHA-256 so what is shown
                    // is exactly what the approval register records.
                    function fetchAttachmentBytes(a, onProgress) {
                        var hit = cachedAttachment(a.index);
                        if (hit) return Promise.resolve(hit);
                        if (!window.fetch || !attachmentEndpoint) {
                            return Promise.reject(userError('This browser cannot open the attached documents.'));
                        }
                        return fetch(attachmentEndpoint + '?index=' + encodeURIComponent(a.index), {
                            method: 'GET',
                            headers: { 'X-Portwood-Token': token },
                            cache: 'no-store',
                            credentials: 'same-origin'
                        })
                            .then(function (res) {
                                if (!res.ok) {
                                    return res
                                        .json()
                                        .catch(function () {
                                            return {};
                                        })
                                        .then(function (body) {
                                            throw userError(
                                                (body && body.error) ||
                                                    'This document could not be loaded (error ' + res.status + ').'
                                            );
                                        });
                                }
                                var serverSha = res.headers.get('X-Portwood-Sha256');
                                return readAll(res, a.size, onProgress).then(function (bytes) {
                                    return verifyAttachment(bytes, serverSha, a);
                                });
                            })
                            .then(function (bytes) {
                                cacheAttachment(a.index, bytes);
                                return bytes;
                            });
                    }

                    function readAll(res, expected, onProgress) {
                        if (!res.body || !res.body.getReader) {
                            return res.arrayBuffer().then(function (buf) {
                                return new Uint8Array(buf);
                            });
                        }
                        var reader = res.body.getReader();
                        var chunks = [];
                        var loaded = 0;
                        function pump() {
                            return reader.read().then(function (step) {
                                if (step.done) {
                                    var out = new Uint8Array(loaded);
                                    var at = 0;
                                    for (var i = 0; i < chunks.length; i++) {
                                        out.set(chunks[i], at);
                                        at += chunks[i].length;
                                    }
                                    return out;
                                }
                                chunks.push(step.value);
                                loaded += step.value.length;
                                if (onProgress) onProgress(loaded, expected);
                                return pump();
                            });
                        }
                        return pump();
                    }

                    function verifyAttachment(bytes, serverSha, a) {
                        if (!window.crypto || !window.crypto.subtle) {
                            return Promise.resolve(bytes); // the server-side hash still stands
                        }
                        return window.crypto.subtle.digest('SHA-256', bytes).then(function (digest) {
                            var hex = Array.prototype.map
                                .call(new Uint8Array(digest), function (b) {
                                    return ('0' + b.toString(16)).slice(-2);
                                })
                                .join('');
                            var expect = (serverSha || a.sha256 || '').toLowerCase();
                            if (expect && expect !== hex) {
                                throw userError('This document did not arrive intact. Please try again.');
                            }
                            a.sha256 = hex;
                            return bytes;
                        });
                    }

                    // Tell the server this attachment was opened (its first page is on screen).
                    // Retries a few times; until it lands the attachment still counts as unopened.
                    function recordAttachmentOpened(a, attempt) {
                        if (a.viewedAt || (a.marking && attempt === 0)) return;
                        a.marking = true;
                        Visualforce.remoting.Manager.invokeAction(
                            '{!$RemoteAction.DocGenSignatureController.markAttachmentViewed}',
                            token,
                            a.index,
                            function (result, event) {
                                if (event.status && result && result.success) {
                                    a.marking = false;
                                    a.viewedAt = result.viewedAt || new Date().toISOString();
                                    syncDocNav();
                                    refreshAttachmentStatus();
                                    refreshActionBar();
                                    return;
                                }
                                if (attempt < 3) {
                                    setTimeout(
                                        function () {
                                            recordAttachmentOpened(a, attempt + 1);
                                        },
                                        1500 * (attempt + 1)
                                    );
                                    return;
                                }
                                a.marking = false;
                                console.error(
                                    'Portwood: could not record opening attached document ' + a.index,
                                    result
                                );
                            },
                            { escape: false }
                        );
                    }

                    // ===== #412 M2 MARKUP =====
                    // PDF.js's own editors draw the marks. When the signer leaves a document, its
                    // marks are saved into a marked-up copy (the original plus appended
                    // annotations), which is uploaded in the background as a draft, so little is
                    // left to send when they approve or decline. Approving or declining submits the
                    // drafts; clearing a document's marks withdraws its draft. Under "Decline only",
                    // markups can only go with a decline; the server enforces the same rule.
                    var markupWired = false;
                    var uploadQueue = Promise.resolve();

                    var lastShape = 'rect'; // the Shapes button shows the last one used
                    var TOOL_KEYS = {
                        v: 'select',
                        h: 'pan',
                        p: 'pen',
                        u: 'highlight',
                        r: 'rect',
                        o: 'ellipse',
                        l: 'line',
                        a: 'arrow',
                        c: 'cloud',
                        t: 'text'
                    };
                    var MENU_SHAPES = { rect: 'square', ellipse: 'circle', line: 'line' };

                    function wireMarkup() {
                        if (markupWired || markupMode === 'Off') return;
                        markupWired = true;
                        var bar = document.getElementById('markup-bar');
                        bar.style.display = '';
                        setMarkupStatus('');
                        bar.addEventListener('click', function (e) {
                            var btn = e.target.closest ? e.target.closest('button') : null;
                            if (!btn || btn.disabled) return;
                            e.stopPropagation();
                            if (btn.dataset.menu) {
                                toggleMenu(btn);
                                return;
                            }
                            if (btn.dataset.tool) {
                                chooseTool(btn.dataset.tool);
                                closeMenus();
                                return;
                            }
                            if (btn.dataset.thickness) {
                                DocGenAttachmentViewer.setStyle({ thickness: Number(btn.dataset.thickness) });
                            } else if (btn.dataset.size) {
                                DocGenAttachmentViewer.setStyle({ fontSize: Number(btn.dataset.size) });
                            } else if (btn.dataset.color) {
                                DocGenAttachmentViewer.setStyle({ color: btn.dataset.color });
                                closeMenus();
                            } else if (btn.id === 'markup-undo') {
                                DocGenAttachmentViewer.undo();
                            } else if (btn.id === 'markup-redo') {
                                DocGenAttachmentViewer.redo();
                            } else if (btn.id === 'markup-delete') {
                                DocGenAttachmentViewer.deleteSelected();
                            } else if (btn.id === 'markup-clear') {
                                clearMarks();
                            }
                            syncStyleMenu();
                        });
                        document.addEventListener('click', closeMenus);
                        document.addEventListener('keydown', onToolKey);
                        syncStyleMenu();
                        window.addEventListener('beforeunload', function (e) {
                            if (hasUnsavedMarks()) {
                                e.preventDefault();
                                e.returnValue = '';
                            }
                        });
                    }

                    function chooseTool(tool) {
                        if (MENU_SHAPES[tool]) {
                            lastShape = tool;
                            document
                                .querySelector('#mk-shapes-icon use')
                                .setAttribute('href', '#dgi-' + MENU_SHAPES[tool]);
                        }
                        DocGenAttachmentViewer.setTool(tool);
                    }

                    function toggleMenu(btn) {
                        var menu = document.getElementById(btn.dataset.menu);
                        var open = menu.style.display === 'none';
                        closeMenus();
                        if (open) {
                            menu.style.display = '';
                            btn.classList.add('open');
                            btn.setAttribute('aria-expanded', 'true');
                        }
                    }

                    function closeMenus() {
                        Array.prototype.forEach.call(document.querySelectorAll('.mk-menu'), function (m) {
                            m.style.display = 'none';
                        });
                        Array.prototype.forEach.call(document.querySelectorAll('[data-menu]'), function (b) {
                            b.classList.remove('open');
                            b.setAttribute('aria-expanded', 'false');
                        });
                    }

                    // Single-letter tool keys, as in Figma and Bluebeam. PDF.js already handles
                    // Ctrl+Z, Ctrl+Shift+Z / Ctrl+Y and Delete for the marks.
                    function onToolKey(e) {
                        if (e.key === 'Escape') closeMenus();
                        if (e.ctrlKey || e.metaKey || e.altKey || !e.key || e.key.length !== 1) return;
                        var t = e.target;
                        if (t && (t.isContentEditable || /^(input|textarea|select)$/i.test(t.tagName || ''))) return;
                        var pane = document.getElementById('attachment-pane');
                        if (currentDoc === 'form' || !pane || pane.offsetParent === null) return;
                        var tool = TOOL_KEYS[e.key.toLowerCase()];
                        if (!tool) return;
                        e.preventDefault();
                        chooseTool(tool);
                    }

                    function syncStyleMenu() {
                        var style = DocGenAttachmentViewer.style();
                        document.getElementById('markup-swatch').style.background = style.color;
                        Array.prototype.forEach.call(
                            document.querySelectorAll(
                                '#markup-bar [data-color], #markup-bar [data-thickness], #markup-bar [data-size]'
                            ),
                            function (b) {
                                var on =
                                    (b.dataset.color && b.dataset.color === style.color) ||
                                    (b.dataset.thickness && Number(b.dataset.thickness) === style.thickness) ||
                                    (b.dataset.size && Number(b.dataset.size) === style.fontSize);
                                b.classList.toggle('active', !!on);
                                if (b.getAttribute('role') === 'menuitemradio') {
                                    b.setAttribute('aria-checked', on ? 'true' : 'false');
                                }
                            }
                        );
                    }

                    function setMarkupStatus(text) {
                        document.getElementById('markup-note').textContent =
                            text ||
                            (markupMode === 'Decline only'
                                ? 'Markups are sent with a decline.'
                                : 'Markups are sent with your approval or decline.');
                    }

                    function syncMarkupBar(z) {
                        if (markupMode === 'Off') return;
                        var ready = !!(z && z.ready);
                        var tool = ready ? z.tool : 'pan';
                        Array.prototype.forEach.call(
                            document.querySelectorAll('#markup-bar [data-tool]'),
                            function (b) {
                                var on = b.dataset.tool === tool;
                                b.classList.toggle('active', on);
                                if (b.hasAttribute('aria-pressed'))
                                    b.setAttribute('aria-pressed', on ? 'true' : 'false');
                                b.disabled = !ready;
                            }
                        );
                        var shapes = document.getElementById('mk-shapes');
                        shapes.classList.toggle('active', !!MENU_SHAPES[tool]);
                        shapes.disabled = !ready;
                        document.getElementById('markup-undo').disabled = !(ready && z.canUndo);
                        document.getElementById('markup-redo').disabled = !(ready && z.canRedo);
                        document.getElementById('markup-delete').disabled = !(ready && z.hasSelection);
                        syncStyleMenu(); // the swatch shows the highlighter's colour while it's the tool
                        var a = currentDoc !== 'form' ? currentDoc : null;
                        document.getElementById('markup-clear').disabled = !(a && isMarkedUp(a));
                        syncDocNav();
                        refreshActionBar();
                    }

                    function isMarkedUp(a) {
                        return !!(
                            a &&
                            (markupBytes[a.index] ||
                                a.markedUpAt ||
                                (a === shownDoc && DocGenAttachmentViewer.hasMarks()))
                        );
                    }

                    function showMarkupNotice(text) {
                        var el = document.getElementById('markup-notice');
                        el.textContent = text || '';
                        el.style.display = text ? '' : 'none';
                    }

                    function hasAnyMarks() {
                        return !!(attachments && attachments.some(isMarkedUp));
                    }

                    function markedUpCount() {
                        return attachments ? attachments.filter(isMarkedUp).length : 0;
                    }

                    // Under "Decline only", marks rule out approving.
                    function declineOnlyBlocked() {
                        return markupMode === 'Decline only' && hasAnyMarks();
                    }

                    function hasUnsavedMarks() {
                        var a = shownDoc;
                        if (a && DocGenAttachmentViewer.hasMarks() && !markupUploaded[a.index]) return true;
                        return Object.keys(markupBytes).some(function (index) {
                            return !markupUploaded[index];
                        });
                    }

                    // The action bar follows the markups: under "Decline only", once there are marks,
                    // signing is off ("Clear your marks to approve") and, once every attached document
                    // has been opened, Decline becomes the main action.
                    function refreshActionBar() {
                        refreshGuidedStatus();
                        var decline = document.getElementById('btn-decline');
                        var blocked = declineOnlyBlocked();
                        decline.classList.toggle('primary', blocked && !unopenedAttachments().length);
                        decline.textContent = blocked ? 'Decline with markups' : 'Decline';
                        // The buttons and the toolbar note say why; a notice line here would push the
                        // drawing down under the signer's pen.
                        if (!hasAnyMarks()) showMarkupNotice('');
                    }

                    // Save the marks on the document on show into its marked-up copy, and start
                    // saving that copy in the background.
                    function captureMarks(background) {
                        var a = shownDoc;
                        if (!a || markupMode === 'Off' || !DocGenAttachmentViewer.hasMarks()) {
                            return Promise.resolve();
                        }
                        return DocGenAttachmentViewer.markedBytes().then(function (bytes) {
                            if (bytes) {
                                markupBytes[a.index] = bytes;
                                delete markupUploaded[a.index];
                                if (background !== false) saveInBackground(a);
                            }
                        });
                    }

                    // One upload at a time; a failure here is retried when the signer finishes.
                    var backgroundBusy = false;

                    function saveInBackground(a) {
                        uploadQueue = uploadQueue.then(function () {
                            if (!markupBytes[a.index] || markupUploaded[a.index]) return null;
                            backgroundBusy = true;
                            setMarkupStatus(
                                'Saving your markup on \u201C' + (a.title || 'this document') + '\u201D\u2026'
                            );
                            return uploadMarkup(a)
                                .then(function () {
                                    backgroundBusy = false;
                                    setMarkupStatus('Markups saved as a draft until you approve or decline.');
                                })
                                .catch(function (err) {
                                    backgroundBusy = false;
                                    console.error('Portwood: background markup save failed', err);
                                    setMarkupStatus(
                                        'Your markup on \u201C' +
                                            (a.title || 'this document') +
                                            '\u201D isn\u2019t saved yet. It will be saved when you finish.'
                                    );
                                });
                        });
                        return uploadQueue;
                    }

                    var clearArmedUntil = 0;

                    function clearMarks() {
                        var a = currentDoc !== 'form' ? currentDoc : null;
                        if (!a) return;
                        var label = document.getElementById('markup-clear-label');
                        if (Date.now() > clearArmedUntil) {
                            // First click arms the button; a second click within 4 s clears.
                            clearArmedUntil = Date.now() + 4000;
                            label.textContent = 'Click again to remove';
                            setTimeout(function () {
                                if (Date.now() >= clearArmedUntil) label.textContent = 'Clear all';
                            }, 4100);
                            return;
                        }
                        clearArmedUntil = 0;
                        label.textContent = 'Clear all';
                        delete markupBytes[a.index];
                        delete markupUploaded[a.index];
                        var hadDraft = !!a.markedUpAt;
                        a.markedUpAt = null;
                        loadAttachment(a); // the original, without marks
                        if (hadDraft) {
                            // Withdraw the saved draft too (after any upload still in flight).
                            uploadQueue = uploadQueue.then(function () {
                                return withdrawMarkup(a).catch(function (err) {
                                    a.markedUpAt = a.markedUpAt || new Date().toISOString();
                                    setMarkupStatus(
                                        err && err.userMessage
                                            ? err.userMessage
                                            : 'Your saved markup could not be removed.'
                                    );
                                    syncDocNav();
                                    refreshActionBar();
                                });
                            });
                        }
                        syncDocNav();
                        refreshActionBar();
                    }

                    // Before approving or declining: finish every upload. report(a, n, of) is told
                    // before each remaining upload, for a progress line; report(null) while a
                    // background save already on its way finishes.
                    function uploadMarkups(report) {
                        if (markupMode === 'Off' || !hasAttachments()) return Promise.resolve();
                        return captureMarks(false)
                            .then(function () {
                                if (backgroundBusy && report) report(null, 0, 0); // one already on its way
                                return uploadQueue;
                            })
                            .then(function () {
                                var todo = attachments.filter(function (a) {
                                    return markupBytes[a.index] && !markupUploaded[a.index];
                                });
                                return todo.reduce(function (chain, a, i) {
                                    return chain.then(function () {
                                        if (report) report(a, i + 1, todo.length);
                                        return uploadMarkup(a);
                                    });
                                }, Promise.resolve());
                            });
                    }

                    function uploadMarkup(a) {
                        var sending = markupBytes[a.index];
                        return markupRequest(a, 'POST', sending).then(function () {
                            // Only the copy actually sent counts as saved; newer marks go next time.
                            if (markupBytes[a.index] === sending) markupUploaded[a.index] = true;
                            a.markedUpAt = new Date().toISOString();
                            syncDocNav();
                        });
                    }

                    function withdrawMarkup(a) {
                        return markupRequest(a, 'DELETE', null);
                    }

                    function markupRequest(a, method, body) {
                        var init = {
                            method: method,
                            headers: { 'X-Portwood-Token': token },
                            cache: 'no-store',
                            credentials: 'same-origin'
                        };
                        if (body) {
                            init.headers['Content-Type'] = 'application/pdf';
                            init.body = body;
                        }
                        return fetch(attachmentEndpoint + '?index=' + encodeURIComponent(a.index), init).then(
                            function (res) {
                                return res
                                    .json()
                                    .catch(function () {
                                        return {};
                                    })
                                    .then(function (json) {
                                        if (!res.ok) {
                                            throw userError(
                                                (json && json.error) ||
                                                    'Your markup on \u201C' +
                                                        (a.title || 'a document') +
                                                        '\u201D could not be saved (error ' +
                                                        res.status +
                                                        ').'
                                            );
                                        }
                                        return json;
                                    });
                            }
                        );
                    }

                    // The signer's saved markup (after a reload), checked against the server's
                    // fingerprint. Kept as this session's copy: it is already saved.
                    function fetchSavedMarkup(a, onProgress) {
                        return fetch(attachmentEndpoint + '?index=' + encodeURIComponent(a.index) + '&markup=1', {
                            method: 'GET',
                            headers: { 'X-Portwood-Token': token },
                            cache: 'no-store',
                            credentials: 'same-origin'
                        }).then(function (res) {
                            if (!res.ok) return fetchAttachmentBytes(a, onProgress); // fall back to the original
                            var serverSha = (res.headers.get('X-Portwood-Sha256') || '').toLowerCase();
                            return readAll(res, null, onProgress).then(function (bytes) {
                                return sha256Hex(bytes).then(function (hex) {
                                    if (serverSha && hex && serverSha !== hex) {
                                        throw userError('Your saved markup did not arrive intact. Please try again.');
                                    }
                                    markupBytes[a.index] = bytes;
                                    markupUploaded[a.index] = true;
                                    return bytes;
                                });
                            });
                        });
                    }

                    function sha256Hex(bytes) {
                        if (!window.crypto || !window.crypto.subtle) return Promise.resolve(null);
                        return window.crypto.subtle.digest('SHA-256', bytes).then(function (digest) {
                            return Array.prototype.map
                                .call(new Uint8Array(digest), function (b) {
                                    return ('0' + b.toString(16)).slice(-2);
                                })
                                .join('');
                        });
                    }

                    // Approve gate (UI side): send the signer to the first unopened attachment.
                    function requireAttachmentsOpened() {
                        if (signerData && signerData.attachmentCount && !attachments) {
                            return false; // manifest still loading — nothing to approve against yet
                        }
                        var left = unopenedAttachments();
                        if (!left.length) return true;
                        closeSignModal();
                        showDocument(left[0]);
                        var status = document.getElementById('doc-status');
                        if (status && status.scrollIntoView) status.scrollIntoView({ block: 'nearest' });
                        return false;
                    }

                    // #412 — the signer confirms they reviewed the attached documents, at the final
                    // step. The server records it (refused until every document was opened) and
                    // refuses approval without it; it records the confirmation, not that every page
                    // was read.
                    function showAttachmentsReviewed(show) {
                        var row = document.getElementById('attachments-reviewed-row');
                        row.style.display = show ? '' : 'none';
                        document.getElementById('attachments-reviewed-checkbox').checked = false;
                        if (show) {
                            document.getElementById('attachments-reviewed-label').textContent =
                                attachments.length === 1
                                    ? 'I confirm I have reviewed the attached document.'
                                    : 'I confirm I have reviewed the ' + attachments.length + ' attached documents.';
                        }
                    }

                    function attachmentsReviewedOk() {
                        return (
                            document.getElementById('attachments-reviewed-row').style.display === 'none' ||
                            document.getElementById('attachments-reviewed-checkbox').checked
                        );
                    }

                    function confirmAttachmentsReviewed() {
                        if (!hasAttachments()) return Promise.resolve(null);
                        return new Promise(function (resolve, reject) {
                            Visualforce.remoting.Manager.invokeAction(
                                '{!$RemoteAction.DocGenSignatureController.confirmAttachmentsReviewed}',
                                token,
                                function (result, event) {
                                    if (!event.status || !result || result.success === false) {
                                        reject(
                                            new Error(
                                                (result && result.message) ||
                                                    event.message ||
                                                    'Your review confirmation could not be recorded. Please try again.'
                                            )
                                        );
                                        return;
                                    }
                                    resolve(result);
                                },
                                { escape: false }
                            );
                        });
                    }

                    // ===== GUIDED SIGN-SPOT OVERLAY =====
                    // Maps this signer's placements to located positions in the PDF and
                    // walks them field-to-field. Only a request with zero placement records
                    // may use the legacy single-modal flow. If placements exist, every anchor
                    // must be located or signing fails closed (issue #407).
                    function labelForType(type) {
                        if (type === 'Initials') return 'INITIAL HERE';
                        if (type === 'Date' || type === 'DatePick') return 'DATE';
                        return 'SIGN HERE';
                    }

                    function initGuidedOverlay() {
                        Visualforce.remoting.Manager.invokeAction(
                            '{!$RemoteAction.DocGenSignatureController.getSignerPlacements}',
                            token,
                            function (placements, event) {
                                if (!event.status || !placements) {
                                    showError(
                                        'The required signature fields could not be loaded. ' +
                                            'Please refresh the page or contact the sender.'
                                    );
                                    return;
                                }
                                if (!placements.length) {
                                    console.info('Portwood signing path: legacy; placements=0; located=0');
                                    return; // legitimate placement-less request
                                }
                                buildGuidedSpots(placements);
                            },
                            { escape: false }
                        );
                    }

                    function buildGuidedSpots(placements) {
                        // Group placements by anchor text, preserving server order, so that
                        // duplicate anchors map to their Nth located occurrence in order.
                        var byNeedle = {};
                        var needles = [];
                        for (var i = 0; i < placements.length; i++) {
                            var p = placements[i];
                            if (!p.tagText) continue;
                            if (!byNeedle[p.tagText]) {
                                byNeedle[p.tagText] = [];
                                needles.push(p.tagText);
                            }
                            byNeedle[p.tagText].push(p);
                        }
                        if (!needles.length) {
                            showError(
                                'This document has required signature fields that cannot be located. ' +
                                    'Please contact the sender.'
                            );
                            return;
                        }

                        var hits = DocGenPdfViewer.locateAnchors(needles);
                        // Bucket hits by needle in document order (locateAnchors already
                        // returns them page-ascending, then left-to-right within a page).
                        var hitsByNeedle = {};
                        for (var h = 0; h < hits.length; h++) {
                            var nd = hits[h].needle;
                            (hitsByNeedle[nd] = hitsByNeedle[nd] || []).push(hits[h]);
                        }

                        var spots = [];
                        for (var k = 0; k < needles.length; k++) {
                            var needle = needles[k];
                            var plcs = byNeedle[needle];
                            var hitList = hitsByNeedle[needle] || [];
                            for (var j = 0; j < plcs.length; j++) {
                                var hit = hitList[j];
                                if (!hit) continue;
                                var plc = plcs[j];
                                var isSigned = plc.status === 'Signed';
                                var chip = DocGenPdfViewer.addChip(hit, labelForType(plc.type), null);
                                if (isSigned) {
                                    renderSignedChip(chip, plc.signedValue, plc.type);
                                }
                                // hit kept for client-side compositing; value/imageData
                                // filled in as the signer captures each field.
                                spots.push({
                                    placement: plc,
                                    chip: chip,
                                    signed: isSigned,
                                    hit: hit,
                                    value: plc.signedValue || null,
                                    imageData: null
                                });
                            }
                        }
                        console.info(
                            'Portwood signing path: guided; placements=' +
                                placements.length +
                                '; located=' +
                                spots.length
                        );
                        if (spots.length !== placements.length || hits.length !== placements.length) {
                            showError(
                                'This document has required signature fields that cannot be located. ' +
                                    'Please contact the sender.'
                            );
                            return;
                        }

                        // Order the walk by sequence (then document position is implicit).
                        spots.sort(function (a, b) {
                            return (a.placement.sequence || 0) - (b.placement.sequence || 0);
                        });
                        guided = { spots: spots };

                        // Wire chip clicks (pending spots only).
                        spots.forEach(function (spot) {
                            spot.chip.addEventListener('click', function () {
                                if (spot.signed) return;
                                if (!requireAttachmentsOpened() || declineOnlyBlocked()) return;
                                ensureFormFieldsThen(function () {
                                    openPlacementCapture(spot);
                                });
                            });
                        });

                        // Repurpose the action bar for guided signing.
                        var btn = document.getElementById('btn-open-sign');
                        btn.textContent = 'Start Signing';
                        // Replace the single-modal click with guided navigation.
                        var freshBtn = btn.cloneNode(true);
                        btn.parentNode.replaceChild(freshBtn, btn);
                        freshBtn.addEventListener('click', function () {
                            advanceGuided(true);
                        });

                        refreshGuidedStatus();
                    }

                    // Turn a chip into its "signed" state: opaque, masking the
                    // sentinel, with the captured value stamped on the line.
                    function renderSignedChip(chip, value, type) {
                        chip.classList.remove('current');
                        // Keep covering AT LEAST the sentinel's width so no tail (e.g. the
                        // trailing "@@") leaks out from under a short value like initials.
                        var sentinelWidth = chip.offsetWidth;
                        chip.classList.add('signed');
                        // Let a longer value grow the chip, but never shrink below the
                        // sentinel it replaces; pin it to the located left edge.
                        chip.style.width = 'auto';
                        chip.style.minWidth = sentinelWidth + 'px';
                        chip.style.height = 'auto';
                        while (chip.firstChild) chip.removeChild(chip.firstChild);
                        var tab = document.createElement('span');
                        tab.className = 'tab';
                        tab.textContent = '✓'; // check mark
                        chip.appendChild(tab);
                        var val = document.createElement('span');
                        var isDate = type === 'Date' || type === 'DatePick';
                        val.className = 'sig-value' + (isDate ? ' plain' : '');
                        val.textContent = value || '';
                        chip.appendChild(val);
                    }

                    function signedCount() {
                        if (!guided) return 0;
                        var c = 0;
                        for (var i = 0; i < guided.spots.length; i++) if (guided.spots[i].signed) c++;
                        return c;
                    }

                    function firstPendingIndex() {
                        if (!guided) return -1;
                        for (var i = 0; i < guided.spots.length; i++) if (!guided.spots[i].signed) return i;
                        return -1;
                    }

                    function refreshGuidedStatus() {
                        if (!guided) return;
                        var total = guided.spots.length;
                        var done = signedCount();
                        var info = document.getElementById('pdf-progress-info');
                        info.textContent = ' — ' + done + ' of ' + total + ' fields completed';
                        info.style.display = 'inline';

                        var btn = document.getElementById('btn-open-sign');
                        var pending = firstPendingIndex();
                        // Clear the "current" highlight, then re-mark the next pending spot.
                        for (var i = 0; i < guided.spots.length; i++) {
                            guided.spots[i].chip.classList.remove('current');
                        }
                        var unopened = unopenedAttachments().length;
                        btn.disabled = false;
                        if (unopened) {
                            // #412 — the signer reviews every attached document before signing,
                            // whichever side of the form they sit on. It stays the main action once
                            // they have marks too, so a decline with markups covers the whole set.
                            btn.textContent =
                                'Review attached document' + (unopened === 1 ? '' : 's') + ' (' + unopened + ' left)';
                        } else if (declineOnlyBlocked()) {
                            // #412 M2 — under "Decline only", markups rule out approving.
                            btn.textContent = 'Clear your marks to approve';
                            btn.disabled = true;
                        } else if (pending < 0) {
                            btn.textContent = 'Finish & Submit';
                        } else {
                            guided.spots[pending].chip.classList.add('current');
                            btn.textContent =
                                done === 0 ? 'Start Signing' : 'Next Field (' + (done + 1) + ' of ' + total + ')';
                        }
                    }

                    // Move to the next pending spot. openNext controls the two paces:
                    //   openNext=true  ("Save & Next" / "Start Signing" / "Next Field"): scroll to
                    //     the next field AND open its capture modal (Date spots auto-fill and the
                    //     walk continues), or open the final submit when none remain — fast path.
                    //   openNext=false ("Save" / a direct chip click on a Date): scroll to the next
                    //     field and highlight it, but DON'T open its modal, so the signer can read
                    //     before acting — deliberate path. They click the chip or "Next Field" next.
                    function advanceGuided(openNext) {
                        if (!guided) return;
                        // #412 — review every attached document before signing anything; under
                        // "Decline only", markups rule out approving.
                        if (!requireAttachmentsOpened()) return;
                        if (declineOnlyBlocked()) {
                            closeSignModal();
                            refreshActionBar();
                            return;
                        }
                        // #412 — the walk happens on the signing document.
                        if (currentDoc !== 'form' && firstPendingIndex() >= 0) showDocument('form');
                        // Form fields first — collect them before the signer signs anything.
                        if (hasPendingFormFields()) {
                            openFormFieldsStep(function () {
                                advanceGuided(openNext);
                            });
                            return;
                        }
                        var pending = firstPendingIndex();
                        if (pending < 0) {
                            // All fields done — only the fast path auto-opens the final submit;
                            // the deliberate path leaves the "Finish & Submit" button for the signer.
                            if (openNext) openFinalSubmit();
                            return;
                        }
                        var spot = guided.spots[pending];
                        DocGenPdfViewer.scrollToChip(spot.chip);
                        if (openNext) {
                            openPlacementCapture(spot, false, true);
                        }
                        // else: scroll-only. refreshGuidedStatus (called by the caller) has already
                        // marked this chip 'current'; the signer opens it when ready to sign.
                    }

                    // Finalize an auto-populated Date placement without a modal: mirrors the
                    // Date branch of handleSpotSubmit (empty value — the server/composite stamp
                    // today's date), then advances at the caller's pace (openNext). Falls back to
                    // the manual modal on error so a failed call never strands the signer.
                    function autoCompleteDateSpot(spot, openNext) {
                        spot.imageData = null;
                        spot.value = '';
                        Visualforce.remoting.Manager.invokeAction(
                            '{!$RemoteAction.DocGenSignatureController.signPlacement}',
                            token,
                            spot.placement.id,
                            '',
                            function (placements, event) {
                                if (!event.status) {
                                    // Don't strand the signer — show the manual modal
                                    // (forceModal=true so it doesn't loop back to auto).
                                    openPlacementCapture(spot, true, openNext);
                                    return;
                                }
                                syncGuidedFromPlacements(placements);
                                refreshGuidedStatus();
                                advanceGuided(openNext);
                            },
                            { escape: false }
                        );
                    }

                    // ===== byte helpers (base64 <-> Uint8Array) for pdf-lib =====
                    function b64ToBytes(b64) {
                        var bin = atob(b64);
                        var a = new Uint8Array(bin.length);
                        for (var i = 0; i < bin.length; i++) a[i] = bin.charCodeAt(i);
                        return a;
                    }
                    function bytesToB64(bytes) {
                        var bin = '';
                        var chunk = 0x8000;
                        for (var i = 0; i < bytes.length; i += chunk) {
                            bin += String.fromCharCode.apply(null, bytes.subarray(i, i + chunk));
                        }
                        return btoa(bin);
                    }
                    function dataUrlToBytes(d) {
                        return b64ToBytes(d.split(',')[1]);
                    }

                    // ===== Draw-pad: free-hand signature capture (#163) =====
                    var DrawPad = (function () {
                        var canvas,
                            ctx,
                            drawing = false,
                            inked = false;
                        function pos(e) {
                            var r = canvas.getBoundingClientRect();
                            var cx = (e.touches ? e.touches[0].clientX : e.clientX) - r.left;
                            var cy = (e.touches ? e.touches[0].clientY : e.clientY) - r.top;
                            return { x: cx * (canvas.width / r.width), y: cy * (canvas.height / r.height) };
                        }
                        function start(e) {
                            drawing = true;
                            var p = pos(e);
                            ctx.beginPath();
                            ctx.moveTo(p.x, p.y);
                            if (e.cancelable) e.preventDefault();
                        }
                        function move(e) {
                            if (!drawing) return;
                            var p = pos(e);
                            ctx.lineTo(p.x, p.y);
                            ctx.stroke();
                            inked = true;
                            if (typeof updateSignSubmitState === 'function') updateSignSubmitState();
                            if (e.cancelable) e.preventDefault();
                        }
                        function end() {
                            drawing = false;
                        }
                        return {
                            init: function () {
                                canvas = document.getElementById('modal-draw-canvas');
                                if (!canvas) return;
                                ctx = canvas.getContext('2d');
                                ctx.lineWidth = 2.5;
                                ctx.lineCap = 'round';
                                ctx.lineJoin = 'round';
                                ctx.strokeStyle = '#16324f';
                                canvas.addEventListener('mousedown', start);
                                canvas.addEventListener('mousemove', move);
                                window.addEventListener('mouseup', end);
                                canvas.addEventListener('touchstart', start, { passive: false });
                                canvas.addEventListener('touchmove', move, { passive: false });
                                canvas.addEventListener('touchend', end);
                                var clr = document.getElementById('modal-draw-clear');
                                if (clr)
                                    clr.addEventListener('click', function () {
                                        DrawPad.clear();
                                    });
                            },
                            clear: function () {
                                if (ctx) ctx.clearRect(0, 0, canvas.width, canvas.height);
                                inked = false;
                                if (typeof updateSignSubmitState === 'function') updateSignSubmitState();
                            },
                            hasInk: function () {
                                return inked;
                            },
                            toPng: function () {
                                return canvas.toDataURL('image/png');
                            }
                        };
                    })();

                    // Render a signed chip showing the DRAWN signature image (vs. text).
                    function renderSignedChipImage(chip, dataUrl) {
                        chip.classList.remove('current');
                        chip.classList.add('signed');
                        chip.style.height = 'auto';
                        while (chip.firstChild) chip.removeChild(chip.firstChild);
                        var tab = document.createElement('span');
                        tab.className = 'tab';
                        tab.textContent = '✓';
                        chip.appendChild(tab);
                        var img = document.createElement('img');
                        img.src = dataUrl;
                        img.style.cssText = 'max-height:26px;width:auto;display:block;';
                        chip.appendChild(img);
                    }

                    // Fetch the certificate roster (all signers + whether this signer
                    // completes the request). Resolves null on failure (cert is best-effort).
                    function getCertificateData() {
                        return new Promise(function (resolve) {
                            Visualforce.remoting.Manager.invokeAction(
                                '{!$RemoteAction.DocGenSignatureController.getSignatureCertificate}',
                                token,
                                function (data, event) {
                                    resolve(event.status && data ? data : null);
                                },
                                { escape: false }
                            );
                        });
                    }

                    // Build a timestamp matching the server audit format
                    // ('MMMM d, yyyy h:mm a z') so the completing signer's cert line reads
                    // consistently with the other signers' server-formatted lines (no
                    // locale "at", includes a timezone abbreviation).
                    function nowStamp() {
                        var d = new Date();
                        try {
                            var month = d.toLocaleString('en-US', { month: 'long' });
                            var hours = d.getHours();
                            var ampm = hours >= 12 ? 'PM' : 'AM';
                            var h12 = hours % 12 === 0 ? 12 : hours % 12;
                            var mins = ('0' + d.getMinutes()).slice(-2);
                            var tz = '';
                            try {
                                var parts = d.toLocaleTimeString('en-US', { timeZoneName: 'short' }).split(' ');
                                tz = parts[parts.length - 1];
                            } catch (e2) {
                                /* tz best-effort */
                            }
                            return (
                                month +
                                ' ' +
                                d.getDate() +
                                ', ' +
                                d.getFullYear() +
                                ' ' +
                                h12 +
                                ':' +
                                mins +
                                ' ' +
                                ampm +
                                (tz ? ' ' + tz : '')
                            );
                        } catch (e) {
                            return d.toString();
                        }
                    }

                    // Append a Certificate of Completion page (audit roster + verify pointer).
                    // Certificate page is Letter portrait (612x792) drawn at a 54pt
                    // left margin, so a line has 504pt before it runs off the sheet.
                    var CERT_LEFT = 54;
                    var CERT_LINE_WIDTH = 612 - CERT_LEFT * 2;

                    /**
                     * Draws text across as many lines as it needs and returns the new y.
                     *
                     * pdf-lib's drawText puts everything on one line at a fixed x and
                     * silently runs off the page — there is no CSS here to wrap it, so
                     * the wrapping has to be measured. The verify URL always overflows:
                     * it carries an unguessable token and has no spaces to break at,
                     * which is why this breaks mid-token when a whole "word" cannot fit.
                     */
                    function drawWrappedText(page, text, opts) {
                        var font = opts.font;
                        var size = opts.size;
                        var maxWidth = opts.maxWidth || CERT_LINE_WIDTH;
                        var lineHeight = opts.lineHeight || size + 3;
                        var y = opts.y;
                        var words = String(text).split(' ');
                        var line = '';

                        function flush() {
                            if (line === '') {
                                return;
                            }
                            page.drawText(line, { x: opts.x, y: y, size: size, font: font, color: opts.color });
                            y -= lineHeight;
                            line = '';
                        }

                        for (var w = 0; w < words.length; w++) {
                            var candidate = line === '' ? words[w] : line + ' ' + words[w];
                            if (font.widthOfTextAtSize(candidate, size) <= maxWidth) {
                                line = candidate;
                                continue;
                            }
                            flush();
                            // A single token wider than the line (a URL) has no space to
                            // break at, so walk it character by character.
                            var token = words[w];
                            if (font.widthOfTextAtSize(token, size) <= maxWidth) {
                                line = token;
                                continue;
                            }
                            var chunk = '';
                            for (var c = 0; c < token.length; c++) {
                                if (font.widthOfTextAtSize(chunk + token[c], size) > maxWidth) {
                                    page.drawText(chunk, {
                                        x: opts.x,
                                        y: y,
                                        size: size,
                                        font: font,
                                        color: opts.color
                                    });
                                    y -= lineHeight;
                                    chunk = '';
                                }
                                chunk += token[c];
                            }
                            line = chunk;
                        }
                        flush();
                        return y;
                    }

                    // pdf-lib's standard fonts only encode WinAnsi; anything else (CJK, symbols)
                    // would throw mid-composite, so swap it for '?' on the register page.
                    function winAnsi(text) {
                        var extras =
                            '\u20AC\u201A\u0192\u201E\u2026\u2020\u2021\u02C6\u2030\u0160\u2039\u0152\u017D' +
                            '\u2018\u2019\u201C\u201D\u2022\u2013\u2014\u02DC\u2122\u0161\u203A\u0153\u017E\u0178';
                        return String(text == null ? '' : text).replace(/[^\x20-\x7E\xA0-\xFF]/g, function (c) {
                            return extras.indexOf(c) >= 0 ? c : '?';
                        });
                    }

                    // #412 — "Attached Documents" register: one entry per attachment with its
                    // version, size, SHA-256 and who opened it when. The documents themselves stay
                    // on the record, unchanged; the hash ties this approval to exact bytes.
                    function addAttachmentRegister(doc, helv, helvBold, cert) {
                        var rgb = PDFLib.rgb;
                        var gray = rgb(0.44, 0.43, 0.42);
                        var brand = rgb(0.005, 0.27, 0.52);
                        var list = cert.attachments;
                        var page;
                        var y;
                        function newPage(continued) {
                            page = doc.addPage([612, 792]);
                            y = 740;
                            page.drawText('Attached Documents' + (continued ? ' (continued)' : ''), {
                                x: CERT_LEFT,
                                y: y,
                                size: 18,
                                font: helvBold,
                                color: brand
                            });
                            y -= 28;
                        }
                        newPage(false);
                        page.drawText(winAnsi('Document: ' + (cert.documentTitle || 'Document')), {
                            x: CERT_LEFT,
                            y: y,
                            size: 10,
                            font: helv
                        });
                        y -= 14;
                        page.drawText('Request ID: ' + (cert.requestId || ''), {
                            x: CERT_LEFT,
                            y: y,
                            size: 9,
                            font: helv,
                            color: gray
                        });
                        y -= 20;
                        y = drawWrappedText(
                            page,
                            'These ' +
                                list.length +
                                ' document' +
                                (list.length === 1 ? ' was' : 's were') +
                                ' attached to this request and opened by the signers below before signing. ' +
                                'Each is identified by its file version and SHA-256 fingerprint; the documents ' +
                                'themselves are kept, unchanged, on the originating record.',
                            { x: CERT_LEFT, y: y, size: 9, font: helv, color: gray, lineHeight: 12 }
                        );
                        y -= 14;
                        for (var i = 0; i < list.length; i++) {
                            var a = list[i];
                            var opened = a.openedBy || [];
                            var markedUp = a.markedUpBy || [];
                            var need = 52 + Math.max(1, opened.length) * 12 + markedUp.length * 24;
                            if (y - need < 60) newPage(true);
                            y = drawWrappedText(page, winAnsi(i + 1 + '. ' + (a.title || 'Document')), {
                                x: CERT_LEFT,
                                y: y,
                                size: 10,
                                font: helvBold,
                                lineHeight: 13
                            });
                            var facts = [];
                            if (a.version) facts.push('Version ' + a.version);
                            if (a.size) facts.push(formatBytes(a.size));
                            facts.push(a.position === 'After' ? 'shown after the form' : 'shown before the form');
                            page.drawText(winAnsi(facts.join('  |  ')), {
                                x: CERT_LEFT + 6,
                                y: y,
                                size: 8.5,
                                font: helv,
                                color: gray
                            });
                            y -= 12;
                            page.drawText('SHA-256: ' + (a.sha256 || 'not recorded'), {
                                x: CERT_LEFT + 6,
                                y: y,
                                size: 7.5,
                                font: helv,
                                color: gray
                            });
                            y -= 12;
                            if (!opened.length) {
                                page.drawText('Opened by: (not recorded)', {
                                    x: CERT_LEFT + 6,
                                    y: y,
                                    size: 8.5,
                                    font: helv,
                                    color: gray
                                });
                                y -= 12;
                            }
                            for (var j = 0; j < opened.length; j++) {
                                y = drawWrappedText(
                                    page,
                                    winAnsi(
                                        (j === 0 ? 'Opened by: ' : '                  ') +
                                            opened[j].name +
                                            ', ' +
                                            opened[j].at
                                    ),
                                    { x: CERT_LEFT + 6, y: y, size: 8.5, font: helv, color: gray, lineHeight: 12 }
                                );
                            }
                            // #412 M2 — each signer's marked-up copy, saved to the record.
                            for (var m = 0; m < markedUp.length; m++) {
                                y = drawWrappedText(
                                    page,
                                    winAnsi(
                                        'Marked up by: ' +
                                            markedUp[m].name +
                                            ', ' +
                                            (markedUp[m].at || '') +
                                            ' (saved to the record)'
                                    ),
                                    { x: CERT_LEFT + 6, y: y, size: 8.5, font: helv, color: gray, lineHeight: 12 }
                                );
                                page.drawText('Markup SHA-256: ' + (markedUp[m].sha256 || 'not recorded'), {
                                    x: CERT_LEFT + 6,
                                    y: y,
                                    size: 7.5,
                                    font: helv,
                                    color: gray
                                });
                                y -= 12;
                            }
                            y -= 10;
                        }
                        var reviews = cert.attachmentReviews || [];
                        if (y - (64 + Math.max(1, reviews.length) * 12) < 60) newPage(true);
                        y -= 4;
                        page.drawText('Review confirmations', {
                            x: CERT_LEFT,
                            y: y,
                            size: 11,
                            font: helvBold
                        });
                        y -= 15;
                        y = drawWrappedText(
                            page,
                            'Each signer below confirmed that they had reviewed the attached documents before ' +
                                'signing. This records their confirmation; it does not show that every page was read.',
                            { x: CERT_LEFT, y: y, size: 9, font: helv, color: gray, lineHeight: 12 }
                        );
                        y -= 4;
                        if (!reviews.length) {
                            page.drawText('(none recorded)', {
                                x: CERT_LEFT + 6,
                                y: y,
                                size: 8.5,
                                font: helv,
                                color: gray
                            });
                        }
                        for (var k = 0; k < reviews.length; k++) {
                            if (y < 72) newPage(true);
                            y = drawWrappedText(page, winAnsi(reviews[k].name + ', ' + reviews[k].at), {
                                x: CERT_LEFT + 6,
                                y: y,
                                size: 8.5,
                                font: helv,
                                color: gray,
                                lineHeight: 12
                            });
                        }
                    }

                    function addCertificatePage(doc, helv, helvBold, cert, meStamp) {
                        var rgb = PDFLib.rgb;
                        var gray = rgb(0.44, 0.43, 0.42);
                        var brand = rgb(0.005, 0.27, 0.52);
                        var page = doc.addPage([612, 792]);
                        var y = 740;
                        page.drawText('Certificate of Completion', {
                            x: 54,
                            y: y,
                            size: 18,
                            font: helvBold,
                            color: brand
                        });
                        y -= 28;
                        page.drawText('Document: ' + (cert.documentTitle || 'Document'), {
                            x: 54,
                            y: y,
                            size: 10,
                            font: helv
                        });
                        y -= 14;
                        page.drawText('Request ID: ' + (cert.requestId || ''), {
                            x: 54,
                            y: y,
                            size: 9,
                            font: helv,
                            color: gray
                        });
                        y -= 28;
                        page.drawText('Signers', { x: 54, y: y, size: 12, font: helvBold });
                        y -= 18;
                        (cert.signers || []).forEach(function (s) {
                            var signedNow = s.isMe && !s.signedAt;
                            var when = signedNow ? meStamp : s.signedAt || 'Pending';
                            // The completing signer's audit row is written immediately after
                            // this, so use the IP captured client-side for their line.
                            var ip = s.ip || (signedNow ? capturedIp : '') || '—';
                            var consent = s.consent || s.isMe ? 'Accepted' : '—';
                            var nameLine = (s.name || 'Signer') + (s.role ? '  (' + s.role + ')' : '');
                            page.drawText(nameLine, { x: 60, y: y, size: 10, font: helvBold });
                            y -= 13;
                            if (s.email) {
                                page.drawText(s.email, { x: 60, y: y, size: 9, font: helv, color: gray });
                                y -= 12;
                            }
                            page.drawText('Signed: ' + when + '      Email verified: ' + (s.verified ? 'Yes' : 'No'), {
                                x: 60,
                                y: y,
                                size: 9,
                                font: helv,
                                color: gray
                            });
                            y -= 12;
                            page.drawText('IP address: ' + ip + '      Consent: ' + consent, {
                                x: 60,
                                y: y,
                                size: 9,
                                font: helv,
                                color: gray
                            });
                            y -= 12;
                            // Device / user agent (full string is retained in the audit
                            // record; truncated here to fit one line).
                            var ua = s.userAgent || (signedNow ? navigator.userAgent : '') || '';
                            if (ua) {
                                if (ua.length > 95) ua = ua.substring(0, 95) + '…';
                                page.drawText('Device: ' + ua, { x: 60, y: y, size: 7.5, font: helv, color: gray });
                            }
                            y -= 22;
                        });
                        // Form Field Responses — list configured fields flagged
                        // listOnCertificate with the value this signer entered (mirrors the
                        // server certificate's section so the drawn path matches the typed path).
                        var ffCertDefs = signerData && signerData.formFields ? signerData.formFields : [];
                        var ffCertShown = [];
                        for (var ci = 0; ci < ffCertDefs.length; ci++) {
                            if (ffCertDefs[ci].listOnCertificate) ffCertShown.push(ffCertDefs[ci]);
                        }
                        if (ffCertShown.length) {
                            var ffCertVals = {};
                            try {
                                ffCertVals = JSON.parse(collectedFormFieldJson || '{}') || {};
                            } catch (e) {
                                ffCertVals = {};
                            }
                            y -= 6;
                            page.drawText('Form Field Responses', { x: 54, y: y, size: 12, font: helvBold });
                            y -= 18;
                            for (var cj = 0; cj < ffCertShown.length; cj++) {
                                var fdef = ffCertShown[cj];
                                var frawv = ffCertVals[fdef.key];
                                var fdisp;
                                if (fdef.type === 'checkbox') {
                                    fdisp = frawv === true || frawv === 'true' ? 'Yes' : 'No';
                                } else {
                                    fdisp = frawv == null || frawv === '' ? '—' : String(frawv);
                                }
                                page.drawText((fdef.label || fdef.key) + ': ' + fdisp, {
                                    x: 60,
                                    y: y,
                                    size: 9,
                                    font: helv,
                                    color: gray
                                });
                                y -= 13;
                            }
                            y -= 9;
                        }
                        y -= 6;
                        // Integrity + verification pointer. We intentionally do NOT print a
                        // raw SHA-256 on the certificate: the authoritative hash is of the
                        // FINAL delivered PDF (computed server-side in saveCompositedSignedPdf,
                        // stored on the audit record, and checked by the verify page's
                        // file-drop). A page inside the PDF cannot contain the final file's own
                        // hash, so printing a pre-certificate hash would show a value that never
                        // matches the delivered file — misleading. Point the recipient at the
                        // verify page instead, which confirms the file's hash directly.
                        page.drawText(
                            'This certificate evidences an electronic signature under the US ESIGN Act and UETA.',
                            { x: 54, y: y, size: 8, font: helv, color: gray }
                        );
                        y -= 14;
                        page.drawText(
                            'The SHA-256 hash of the signed PDF is recorded in a tamper-evident audit record.',
                            { x: 54, y: y, size: 8, font: helv, color: gray }
                        );
                        if (cert && cert.verifyUrl) {
                            y -= 16;
                            page.drawText('Verify this document at:', {
                                x: 54,
                                y: y,
                                size: 8,
                                font: helvBold,
                                color: gray
                            });
                            y -= 12;
                            // Wrapped, not truncated: a clipped verify URL is useless to
                            // whoever has to check the document. drawWrappedText returns
                            // the y AFTER the last line it drew, so the sentence below
                            // moves down instead of landing on top of a two-line URL.
                            y = drawWrappedText(page, String(cert.verifyUrl), {
                                x: 54,
                                y: y,
                                size: 7.5,
                                font: helv,
                                color: brand,
                                lineHeight: 10
                            });
                            y -= 2;
                            page.drawText('Drop the PDF you received at that link to confirm its integrity.', {
                                x: 54,
                                y: y,
                                size: 7.5,
                                font: helv,
                                color: gray
                            });
                        }
                    }

                    // Composite ALL captured fields (drawn images + typed text + dates) onto
                    // the source PDF with pdf-lib, add signature attribution captions, and —
                    // when this signer completes the request — a Certificate of Completion
                    // page, then finalize via saveCompositedSignedPdf. In-browser; no server
                    // re-render and no image-fetch limitation. Returns a Promise.
                    function compositeAndFinalize(typedName, consentGiven, btn, formFieldJson) {
                        if (typeof PDFLib === 'undefined') {
                            return Promise.reject(new Error('PDFLib not loaded'));
                        }
                        var rgb = PDFLib.rgb;
                        var capStamp = nowStamp();
                        // Short date for the inline caption (full timestamp lives on the
                        // certificate page) so the caption fits beside the signature without
                        // bleeding into an adjacent column.
                        var capShort = (function () {
                            try {
                                return new Date().toLocaleDateString(undefined, {
                                    year: 'numeric',
                                    month: 'short',
                                    day: 'numeric'
                                });
                            } catch (e) {
                                return '';
                            }
                        })();
                        return uploadMarkups(function (a, n, of) {
                            if (!a) {
                                showModalMsg('Saving your markups\u2026 Please keep this page open.', 'info');
                                return;
                            }
                            showModalMsg(
                                'Saving your markup on \u201C' +
                                    escapeHtml(a.title || 'a document') +
                                    '\u201D (' +
                                    n +
                                    ' of ' +
                                    of +
                                    ')\u2026 Please keep this page open.',
                                'info'
                            );
                        })
                            .then(confirmAttachmentsReviewed)
                            .then(getCertificateData)
                            .then(function (cert) {
                                // #412 — never finish an attachment request without its register:
                                // a missing or short register would leave an approval that doesn't
                                // say which documents were approved.
                                var expected =
                                    signerData && signerData.attachmentCount ? signerData.attachmentCount : 0;
                                if (
                                    expected &&
                                    (!cert ||
                                        (cert.othersAllSigned &&
                                            (!cert.attachments ||
                                                cert.attachments.length !== expected ||
                                                !cert.attachmentReviews)))
                                ) {
                                    throw new Error(
                                        'The attached-documents register could not be loaded. Please try again.'
                                    );
                                }
                                var bytes = b64ToBytes(sourcePdfBase64);
                                return PDFLib.PDFDocument.load(bytes).then(function (doc) {
                                    return Promise.all([
                                        doc.embedFont(PDFLib.StandardFonts.HelveticaOblique),
                                        doc.embedFont(PDFLib.StandardFonts.Helvetica),
                                        doc.embedFont(PDFLib.StandardFonts.HelveticaBold)
                                    ]).then(function (fonts) {
                                        var oblique = fonts[0],
                                            helv = fonts[1],
                                            helvBold = fonts[2];
                                        var pages = doc.getPages();
                                        // Renders a DocuSign-style stamp card: an opaque backdrop +
                                        // brand border so it reads as a deliberate stamp, the drawn ink
                                        // (signature or initials), and a "<labelLine> · Portwood"
                                        // footer. Whitespace-aware: it grows into whichever side of the
                                        // field line has more clearance (rect.clearAbove/clearBelow, from
                                        // the text layer) so it never covers the line above (body text)
                                        // nor the label below (e.g. "Member Signature"); if neither side
                                        // fully fits, the ink shrinks to the larger gap. sigH sets the
                                        // ink height (20 = signature, 14 = initials). Returns its width.
                                        // Inline fallback for a field with no surrounding whitespace
                                        // (a tag dropped mid-prose): render just the ink at ~line height,
                                        // no box/footer, so it never covers adjacent text. Width returned.
                                        function drawInlineMark(page, ink, rect) {
                                            var h = Math.min(Math.max(rect.h, 11), 16);
                                            if (ink.png) {
                                                var asp = ink.png.width / ink.png.height || 3;
                                                var w = Math.min(h * asp, 90);
                                                page.drawImage(ink.png, {
                                                    x: rect.x,
                                                    y: rect.yBottom,
                                                    width: w,
                                                    height: h
                                                });
                                                return w;
                                            }
                                            var sz = Math.min(Math.max(rect.h, 10), 15);
                                            page.drawText(ink.text || '', {
                                                x: rect.x,
                                                y: rect.yBottom + 1,
                                                size: sz,
                                                font: oblique,
                                                color: rgb(0.07, 0.11, 0.25)
                                            });
                                            return oblique.widthOfTextAtSize(ink.text || '', sz);
                                        }
                                        // ink = { png: <embedded PNG> } for a drawn mark, or
                                        //       { text: <string> } for a typed signature/initials
                                        //       (rendered in the oblique "signature" font).
                                        function drawStampCard(page, ink, rect, sigH, labelLine) {
                                            var blue = rgb(0.13, 0.36, 0.62);
                                            var grayTxt = rgb(0.4, 0.4, 0.42);
                                            var hair = rgb(0.8, 0.84, 0.9);
                                            var pad = 4;
                                            var sigW;
                                            if (ink.png) {
                                                var aspect = ink.png.width / ink.png.height || 3;
                                                sigW = Math.max(Math.min(sigH * aspect, 200), 50);
                                            } else {
                                                sigW = Math.max(
                                                    Math.min(oblique.widthOfTextAtSize(ink.text || '', sigH), 200),
                                                    50
                                                );
                                            }
                                            var labelSize = 6.5,
                                                brandSize = 6;
                                            var brand = 'Portwood';
                                            var labelW = helv.widthOfTextAtSize(labelLine, labelSize);
                                            var brandW = helvBold.widthOfTextAtSize(brand, brandSize);
                                            var accent = 3;
                                            var innerW = Math.max(sigW, labelW + 10 + brandW);
                                            var cardW = accent + pad + innerW + pad;
                                            var labelH = 9;
                                            var cardH = pad + sigH + 4 + labelH + pad;
                                            // Clearance to the nearest text above/below the field line.
                                            var above = rect.clearAbove != null ? rect.clearAbove : 9999;
                                            var below = rect.clearBelow != null ? rect.clearBelow : 9999;
                                            // INLINE field (tag mid-prose, no whitespace either side): a
                                            // boxed card would cover the surrounding text, so degrade to a
                                            // clean inline mark instead. Author fix is to put the field in
                                            // its own table cell / line (see UserGuide).
                                            if (Math.max(above, below) < 8) {
                                                return drawInlineMark(page, ink, rect);
                                            }
                                            var need = cardH - rect.h; // extra height beyond the field line
                                            // Signature/initials cards prefer growing DOWN so the ink sits
                                            // on the signing line. Deterministic — keys off the room BELOW
                                            // only, not a below-vs-above comparison — so two co-located
                                            // signatures composited in SEPARATE signer sessions (a
                                            // "Provider | Client" block signed by different people) make the
                                            // SAME choice and stay aligned, instead of one hugging the line
                                            // while the other floats a full card-height above it. Only when
                                            // the room below is too tight to seat the card do we fall back to
                                            // the larger gap; co-located fields share that below gap, so they
                                            // still agree. (14pt ≈ half a line of slack.)
                                            var growDown = below >= 14 || below >= above;
                                            var room = growDown ? below : above;
                                            if (need > 0 && room < need) {
                                                // neither gap fits fully — shrink ink to the larger gap,
                                                // keeping the footer legible.
                                                sigH = Math.max(9, sigH - (need - room));
                                                cardH = pad + sigH + 4 + labelH + pad;
                                            }
                                            // Grow down → card top at the line top; grow up → card bottom
                                            // at the line bottom. Either way the card brackets the field.
                                            var botY = growDown ? rect.yBottom + rect.h - cardH : rect.yBottom;
                                            var x0 = rect.x;
                                            // Transparent backdrop + brand border: the frame still reads as a
                                            // deliberate stamp, but no opaque fill — so if the stamp ever
                                            // overlaps document text the text stays visible behind it (the
                                            // drawn ink itself is a transparent PNG). Omitting `color` leaves
                                            // the rectangle interior unpainted; only the border is drawn.
                                            page.drawRectangle({
                                                x: x0,
                                                y: botY,
                                                width: cardW,
                                                height: cardH,
                                                borderColor: blue,
                                                borderWidth: 0.75
                                            });
                                            // left accent bar
                                            page.drawRectangle({
                                                x: x0,
                                                y: botY,
                                                width: accent,
                                                height: cardH,
                                                color: blue
                                            });
                                            var innerX = x0 + accent + pad;
                                            // signature ink, upper zone — drawn image or typed text
                                            var sy = botY + cardH - pad - sigH;
                                            if (ink.png) {
                                                page.drawImage(ink.png, {
                                                    x: innerX,
                                                    y: sy,
                                                    width: Math.min(sigW, innerW),
                                                    height: sigH
                                                });
                                            } else {
                                                // baseline a touch above the divider so the script font
                                                // sits in the ink zone like a written signature
                                                page.drawText(ink.text || '', {
                                                    x: innerX,
                                                    y: sy + sigH * 0.18,
                                                    size: sigH,
                                                    font: oblique,
                                                    color: rgb(0.07, 0.11, 0.25)
                                                });
                                            }
                                            // hairline divider between ink and footer
                                            page.drawRectangle({
                                                x: innerX,
                                                y: sy - 2.5,
                                                width: innerW,
                                                height: 0.4,
                                                color: hair
                                            });
                                            // footer: attribution (left) + brand wordmark (right)
                                            var ly = botY + pad;
                                            page.drawText(labelLine, {
                                                x: innerX,
                                                y: ly,
                                                size: labelSize,
                                                font: helv,
                                                color: grayTxt
                                            });
                                            page.drawText(brand, {
                                                x: x0 + cardW - pad - brandW,
                                                y: ly - 0.2,
                                                size: brandSize,
                                                font: helvBold,
                                                color: blue
                                            });
                                            return cardW;
                                        }
                                        var chain = Promise.resolve();
                                        guided.spots.forEach(function (spot) {
                                            chain = chain.then(function () {
                                                var rect = DocGenPdfViewer.hitToPdfRect(spot.hit);
                                                if (!rect || !pages[rect.pageIndex]) return;
                                                var page = pages[rect.pageIndex];
                                                var markW = 0;
                                                var p;
                                                var who =
                                                    signerData && signerData.signerName
                                                        ? signerData.signerName
                                                        : typedName || '';
                                                var fullLabel = 'Signed by ' + (who || '—') + '   ·   ' + capShort;
                                                // Author opted this tag into compact in-place rendering
                                                // ({@Signature_…:inline}) → draw just the ink at line height,
                                                // no stamp card, so it never covers an adjacent label in a
                                                // tight template. The auto-fallback (no-whitespace) still
                                                // applies to non-inline tags inside drawStampCard.
                                                var inlineMode = !!(spot.placement && spot.placement.renderInline);
                                                if (spot.imageData) {
                                                    var isInitials = spot.placement.type === 'Initials';
                                                    p = doc
                                                        .embedPng(dataUrlToBytes(spot.imageData))
                                                        .then(function (png) {
                                                            if (inlineMode) {
                                                                // Drawn mark, in-place (no card).
                                                                markW = drawInlineMark(page, { png: png }, rect);
                                                            } else if (isInitials) {
                                                                // Drawn initials → compact stamp card.
                                                                markW = drawStampCard(
                                                                    page,
                                                                    { png: png },
                                                                    rect,
                                                                    14,
                                                                    'Initialed'
                                                                );
                                                            } else {
                                                                // Drawn signature → full stamp card.
                                                                markW = drawStampCard(
                                                                    page,
                                                                    { png: png },
                                                                    rect,
                                                                    20,
                                                                    fullLabel
                                                                );
                                                            }
                                                        });
                                                } else {
                                                    var text = spot.value || spot.placement.signedValue || '';
                                                    if (!text) return;
                                                    var type = spot.placement.type;
                                                    if (inlineMode && (type === 'Full' || type === 'Initials')) {
                                                        // Typed signature/initials, in-place (no card).
                                                        markW = drawInlineMark(page, { text: text }, rect);
                                                    } else if (type === 'Full') {
                                                        // Typed signature → same stamp card, name as ink.
                                                        markW = drawStampCard(
                                                            page,
                                                            { text: text },
                                                            rect,
                                                            18,
                                                            fullLabel
                                                        );
                                                    } else if (type === 'Initials') {
                                                        // Typed initials → compact stamp card.
                                                        markW = drawStampCard(
                                                            page,
                                                            { text: text },
                                                            rect,
                                                            14,
                                                            'Initialed'
                                                        );
                                                    } else {
                                                        // Date (and any other) → plain stamped text on the line.
                                                        var sz = Math.max(rect.h, 9);
                                                        page.drawText(String(text), {
                                                            x: rect.x,
                                                            y: rect.yBottom + 1,
                                                            size: sz,
                                                            font: oblique
                                                        });
                                                        markW = oblique.widthOfTextAtSize(String(text), sz);
                                                    }
                                                    p = Promise.resolve();
                                                }
                                                return Promise.resolve(p);
                                            });
                                        });
                                        // Stamp signer form-field values ({?key}) at their
                                        // @@FF-<key>@@ sentinel positions. Composite path (drawn
                                        // or typed marks); only the server-fallback path resolves
                                        // {?key} in a re-render instead.
                                        // Mirrors Date spots: locate the (white) sentinel in the
                                        // text layer, draw the collected value on top in black.
                                        chain = chain.then(function () {
                                            var ffDefs =
                                                signerData && signerData.formFields ? signerData.formFields : [];
                                            if (!ffDefs.length) return;
                                            var ffValues = {};
                                            try {
                                                ffValues = JSON.parse(formFieldJson || '{}') || {};
                                            } catch (e) {
                                                ffValues = {};
                                            }
                                            var ffNeedles = [];
                                            var defByKey = {};
                                            for (var fi = 0; fi < ffDefs.length; fi++) {
                                                ffNeedles.push('@@FF-' + ffDefs[fi].key + '@@');
                                                defByKey[ffDefs[fi].key] = ffDefs[fi];
                                            }
                                            var ffHits = DocGenPdfViewer.locateAnchors(ffNeedles);
                                            for (var fh = 0; fh < ffHits.length; fh++) {
                                                var fhit = ffHits[fh];
                                                // strip "@@FF-" (5) ... "@@" (2) → the form-field key
                                                var fkey = fhit.needle.substring(5, fhit.needle.length - 2);
                                                var fdef = defByKey[fkey];
                                                var fraw = ffValues[fkey];
                                                var ftext;
                                                if (fdef && fdef.type === 'checkbox') {
                                                    ftext = fraw === true || fraw === 'true' ? 'Yes' : 'No';
                                                } else {
                                                    ftext = fraw == null ? '' : String(fraw);
                                                }
                                                if (!ftext) continue;
                                                var frect = DocGenPdfViewer.hitToPdfRect(fhit);
                                                if (!frect || !pages[frect.pageIndex]) continue;
                                                var fpage = pages[frect.pageIndex];
                                                var fsz = Math.max(Math.min(frect.h, 12), 8);
                                                fpage.drawText(ftext, {
                                                    x: frect.x,
                                                    y: frect.yBottom + 1,
                                                    size: fsz,
                                                    font: helv
                                                });
                                            }
                                        });
                                        return chain.then(function () {
                                            var iAmCompleting = cert && cert.othersAllSigned;
                                            if (iAmCompleting && cert.attachments && cert.attachments.length) {
                                                // #412 — the approval register: which documents were
                                                // attached, by version and SHA-256, and who opened them.
                                                addAttachmentRegister(doc, helv, helvBold, cert);
                                            }
                                            if (iAmCompleting) {
                                                // Final signer: append the Certificate of Completion
                                                // page. The authoritative integrity hash is computed
                                                // server-side over the FINAL bytes in
                                                // saveCompositedSignedPdf and stored on the audit
                                                // record; the cert links to the verify page rather
                                                // than printing an in-file hash that could never
                                                // match the delivered file.
                                                addCertificatePage(doc, helv, helvBold, cert, capStamp);
                                            }
                                            return doc.save();
                                        });
                                    });
                                });
                            })
                            .then(function (outBytes) {
                                var outB64 = bytesToB64(outBytes);
                                var ua = navigator.userAgent || 'Unknown';
                                return new Promise(function (resolve, reject) {
                                    Visualforce.remoting.Manager.invokeAction(
                                        '{!$RemoteAction.DocGenSignatureController.saveCompositedSignedPdf}',
                                        token,
                                        outB64,
                                        consentGiven,
                                        capturedIp,
                                        ua,
                                        formFieldJson != null ? formFieldJson : '{}',
                                        function (result, event) {
                                            if (!event.status || !result || result.success === false) {
                                                reject(
                                                    new Error(
                                                        (result && result.message) || event.message || 'Save failed'
                                                    )
                                                );
                                                return;
                                            }
                                            resolve(result);
                                        },
                                        { escape: false, buffer: false, timeout: 120000 }
                                    );
                                });
                            });
                    }

                    function openPlacementCapture(spot, forceModal, openNext) {
                        activeSpot = spot;
                        var type = spot.placement.type;

                        // Date placements are auto-stamped with today's date and need no signer
                        // input. Complete them silently (no confirm-only modal) from EVERY entry
                        // point — the guided auto-walk and a direct chip click alike — then move
                        // to the next pending field. DatePick still prompts (the signer types a
                        // date). forceModal is the error-fallback escape hatch from
                        // autoCompleteDateSpot, so a failed auto-call can still show the modal.
                        if (type === 'Date' && !forceModal) {
                            autoCompleteDateSpot(spot, openNext);
                            return;
                        }

                        // Two-button capture: "Save & Next" (brand, primary) saves and opens the
                        // next field; "Save" (secondary) saves and scrolls to the next field
                        // without opening it. The error-fallback Date modal keeps a single button.
                        var saveBtn = document.getElementById('btn-sign-submit');
                        var nextBtn = document.getElementById('btn-sign-submit-next');
                        if (type === 'Date') {
                            // forceModal error fallback — single confirm button, no "next" variant.
                            saveBtn.className = 'btn btn-brand';
                            saveBtn.textContent = 'Add Date';
                            nextBtn.style.display = 'none';
                        } else {
                            saveBtn.className = 'btn';
                            saveBtn.textContent = 'Save';
                            nextBtn.className = 'btn btn-brand';
                            nextBtn.textContent = 'Save & Next';
                            nextBtn.style.display = '';
                        }

                        var titleEl = document.querySelector('#sign-modal .modal-header h2');
                        var subEl = document.querySelector('#sign-modal .modal-subtitle');
                        var nameGroup = document.getElementById('modal-typed-name').parentNode;
                        var nameInput = document.getElementById('modal-typed-name');
                        var nameLabel = document.querySelector('label[for="modal-typed-name"]');
                        var consentRow = document.getElementById('modal-consent-checkbox').parentNode;

                        // Per-spot capture: no consent here (collected once at final submit).
                        consentRow.style.display = 'none';
                        showAttachmentsReviewed(false);
                        // Form fields are collected once at final submit, not per-spot.
                        hideFormFields();
                        showModalMsg('', 'info');

                        // Draw-pad: offer free-hand capture for signature + initials fields.
                        var drawGroup = document.getElementById('modal-draw-group');
                        var allowDraw = type === 'Full' || type === 'Initials';
                        DrawPad.clear();
                        drawGroup.style.display = allowDraw ? '' : 'none';

                        if (type === 'Date') {
                            modalMode = 'spot';
                            titleEl.textContent = 'Add Date';
                            subEl.textContent = "Today's date will be stamped here.";
                            nameGroup.style.display = 'none';
                            document.getElementById('btn-sign-submit').disabled = false;
                        } else {
                            modalMode = 'spot';
                            nameGroup.style.display = '';
                            // DatePick uses a native date picker (validated — the input only has a
                            // value once a real date is chosen, so updateSignSubmitState keeps Save
                            // disabled until then). Every other type uses the free-text input.
                            nameInput.type = type === 'DatePick' ? 'date' : 'text';
                            if (type === 'Initials') {
                                titleEl.textContent = 'Add Initials';
                                subEl.textContent = 'Type your initials for this field.';
                                nameLabel.textContent = 'Your initials';
                                nameInput.placeholder = 'e.g., JS';
                                nameInput.value = '';
                            } else if (type === 'DatePick') {
                                titleEl.textContent = 'Select a Date';
                                subEl.textContent = 'Choose the date for this field.';
                                nameLabel.textContent = 'Date';
                                nameInput.value = '';
                            } else {
                                titleEl.textContent = 'Sign Here';
                                subEl.textContent = 'Type your full name to sign this field.';
                                nameLabel.textContent = 'Type your full name to sign';
                                nameInput.placeholder = 'e.g., John Smith';
                                nameInput.value = signerData && signerData.signerName ? signerData.signerName : '';
                            }
                            updateSignSubmitState();
                        }
                        document.getElementById('sign-modal').style.display = '';
                        setTimeout(function () {
                            if (nameGroup.style.display !== 'none') nameInput.focus();
                        }, 50);
                    }

                    function openFinalSubmit() {
                        // #412 — every attached document must be opened first (server-enforced too).
                        if (!requireAttachmentsOpened()) return;
                        // #412 M2 — under "Decline only", approving means approved as-is.
                        if (markupMode === 'Decline only' && hasAnyMarks()) {
                            showMarkupNotice(
                                'Your markups can only be sent with a decline: approving here means approving the ' +
                                    'documents as they are. To send your markups, choose Decline. To approve, clear ' +
                                    'your marks first.'
                            );
                            return;
                        }
                        showMarkupNotice('');
                        modalMode = 'final';
                        activeSpot = null;
                        document.getElementById('modal-draw-group').style.display = 'none';
                        document.querySelector('#sign-modal .modal-header h2').textContent = 'Complete Signing';
                        // Guided flow: every field was already signed individually, so we don't
                        // re-ask for the signer's name here — it's on the signer record (and is what
                        // pre-fills each field). Only the electronic-signature consent is needed.
                        // (The legacy no-placement flow — openSignModal/'pdf' mode — still collects
                        // the typed name; there the name IS the signature.)
                        var total = guided && guided.spots ? guided.spots.length : 0;
                        document.querySelector('#sign-modal .modal-subtitle').textContent =
                            (total > 0
                                ? "You've completed all " + total + ' field' + (total > 1 ? 's' : '') + '. '
                                : '') +
                            (hasAttachments()
                                ? 'Confirm your review and consent to finalize.'
                                : 'Confirm your consent to finalize.');
                        document.getElementById('modal-typed-name').parentNode.style.display = 'none';
                        document.getElementById('modal-consent-checkbox').parentNode.style.display = '';
                        document.getElementById('modal-consent-checkbox').checked = false;
                        showAttachmentsReviewed(hasAttachments());
                        var finalBtn = document.getElementById('btn-sign-submit');
                        finalBtn.className = 'btn btn-brand';
                        finalBtn.textContent = 'Finish & Submit';
                        document.getElementById('btn-sign-submit-next').style.display = 'none';
                        // Form fields were collected up front (before signing) — not here.
                        hideFormFields();
                        showModalMsg('', 'info');
                        updateSignSubmitState();
                        document.getElementById('sign-modal').style.display = '';
                    }

                    // ===== SIGNER FORM FIELDS (#161) =====
                    // Admin-configured inputs delivered on validateToken.formFields as
                    // [{key,label,type,required,choices}]. Rendered into #modal-form-fields
                    // at the final/consent step only; the per-spot capture flow hides them.
                    var formFieldsRendered = false;

                    function escapeHtml(s) {
                        return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
                            return {
                                '&': '&amp;',
                                '<': '&lt;',
                                '>': '&gt;',
                                '"': '&quot;',
                                "'": '&#39;'
                            }[c];
                        });
                    }

                    // Build labelled inputs by type into `container`. Idempotent: only
                    // builds once per page load (values persist if the modal reopens).
                    function renderFormFields(container, fields) {
                        if (!container) return;
                        if (!fields || !fields.length) {
                            container.style.display = 'none';
                            container.innerHTML = '';
                            return;
                        }
                        if (!formFieldsRendered) {
                            var html = '';
                            for (var i = 0; i < fields.length; i++) {
                                var f = fields[i];
                                var inputId = 'ff-' + f.key;
                                var req = f.required ? ' aria-required="true"' : '';
                                var marker = f.required
                                    ? ' <span class="form-required-marker" aria-hidden="true">*</span>'
                                    : '';
                                var type = f.type || 'text';
                                if (type === 'checkbox') {
                                    html +=
                                        '<div class="form-group">' +
                                        '<div class="form-checkbox-row">' +
                                        '<input id="' +
                                        inputId +
                                        '" type="checkbox" data-key="' +
                                        escapeHtml(f.key) +
                                        '" data-required="' +
                                        (f.required ? '1' : '0') +
                                        '"' +
                                        req +
                                        ' />' +
                                        '<label for="' +
                                        inputId +
                                        '">' +
                                        escapeHtml(f.label) +
                                        marker +
                                        '</label>' +
                                        '</div>' +
                                        '<span class="form-field-error" id="' +
                                        inputId +
                                        '-err" role="alert"></span>' +
                                        '</div>';
                                } else if (type === 'picklist') {
                                    var opts = '<option value=""></option>';
                                    var choices = f.choices || [];
                                    for (var c = 0; c < choices.length; c++) {
                                        opts +=
                                            '<option value="' +
                                            escapeHtml(choices[c]) +
                                            '">' +
                                            escapeHtml(choices[c]) +
                                            '</option>';
                                    }
                                    html +=
                                        '<div class="form-group">' +
                                        '<label for="' +
                                        inputId +
                                        '">' +
                                        escapeHtml(f.label) +
                                        marker +
                                        '</label>' +
                                        '<select id="' +
                                        inputId +
                                        '" class="form-input" data-key="' +
                                        escapeHtml(f.key) +
                                        '" data-required="' +
                                        (f.required ? '1' : '0') +
                                        '"' +
                                        req +
                                        '>' +
                                        opts +
                                        '</select>' +
                                        '<span class="form-field-error" id="' +
                                        inputId +
                                        '-err" role="alert"></span>' +
                                        '</div>';
                                } else {
                                    var htmlType = type === 'number' ? 'number' : type === 'date' ? 'date' : 'text';
                                    html +=
                                        '<div class="form-group">' +
                                        '<label for="' +
                                        inputId +
                                        '">' +
                                        escapeHtml(f.label) +
                                        marker +
                                        '</label>' +
                                        '<input id="' +
                                        inputId +
                                        '" type="' +
                                        htmlType +
                                        '" class="form-input" data-key="' +
                                        escapeHtml(f.key) +
                                        '" data-required="' +
                                        (f.required ? '1' : '0') +
                                        '"' +
                                        req +
                                        ' />' +
                                        '<span class="form-field-error" id="' +
                                        inputId +
                                        '-err" role="alert"></span>' +
                                        '</div>';
                                }
                            }
                            container.innerHTML = html;
                            formFieldsRendered = true;
                            // Live re-validation + submit-state refresh as the signer types.
                            var inputs = container.querySelectorAll('[data-key]');
                            for (var k = 0; k < inputs.length; k++) {
                                inputs[k].addEventListener('input', updateSignSubmitState);
                                inputs[k].addEventListener('change', updateSignSubmitState);
                            }
                        }
                        container.style.display = '';
                    }

                    // Read current values + validate required fields. Returns
                    // { valid: Boolean, values: { key: value } }. Paints inline errors.
                    function validateFormFields() {
                        var container = document.getElementById('modal-form-fields');
                        var values = {};
                        var valid = true;
                        if (!container) return { valid: true, values: values };
                        var inputs = container.querySelectorAll('[data-key]');
                        for (var i = 0; i < inputs.length; i++) {
                            var el = inputs[i];
                            var key = el.getAttribute('data-key');
                            var required = el.getAttribute('data-required') === '1';
                            var errEl = document.getElementById(el.id + '-err');
                            var val;
                            var missing = false;
                            if (el.type === 'checkbox') {
                                val = el.checked;
                                missing = required && !el.checked;
                            } else {
                                val = (el.value || '').trim();
                                missing = required && !val;
                            }
                            values[key] = val;
                            if (missing) {
                                valid = false;
                                if (errEl) {
                                    errEl.textContent = 'This field is required.';
                                    errEl.style.display = '';
                                }
                                if (el.classList) el.classList.add('form-input_invalid');
                            } else {
                                if (errEl) {
                                    errEl.textContent = '';
                                    errEl.style.display = 'none';
                                }
                                if (el.classList) el.classList.remove('form-input_invalid');
                            }
                        }
                        return { valid: valid, values: values };
                    }

                    function showFormFields() {
                        renderFormFields(
                            document.getElementById('modal-form-fields'),
                            signerData && signerData.formFields ? signerData.formFields : null
                        );
                    }

                    function hideFormFields() {
                        var c = document.getElementById('modal-form-fields');
                        if (c) c.style.display = 'none';
                    }

                    // Gate: signer form fields are completed BEFORE any signing. The first
                    // signing action (Start Signing, a sign-spot chip, or the legacy single
                    // modal) routes through ensureFormFieldsThen; once collected, signing
                    // proceeds and the fields are never re-asked at the final/consent step.
                    function hasPendingFormFields() {
                        return (
                            !formFieldsCollected &&
                            signerData &&
                            signerData.formFields &&
                            signerData.formFields.length > 0
                        );
                    }

                    function ensureFormFieldsThen(fn) {
                        if (hasPendingFormFields()) {
                            openFormFieldsStep(fn);
                        } else {
                            fn();
                        }
                    }

                    function openFormFieldsStep(onContinue) {
                        modalMode = 'fields';
                        afterFieldsAction = onContinue || null;
                        document.getElementById('modal-draw-group').style.display = 'none';
                        document.getElementById('modal-typed-name').parentNode.style.display = 'none';
                        document.getElementById('modal-consent-checkbox').parentNode.style.display = 'none';
                        showAttachmentsReviewed(false);
                        document.querySelector('#sign-modal .modal-header h2').textContent = 'Your Information';
                        document.querySelector('#sign-modal .modal-subtitle').textContent =
                            'Complete these fields, then sign to finish.';
                        showFormFields();
                        var c = document.getElementById('modal-form-fields');
                        if (c) c.style.display = '';
                        var fieldsBtn = document.getElementById('btn-sign-submit');
                        fieldsBtn.className = 'btn btn-brand';
                        fieldsBtn.textContent = 'Continue';
                        document.getElementById('btn-sign-submit-next').style.display = 'none';
                        showModalMsg('', 'info');
                        updateSignSubmitState();
                        document.getElementById('sign-modal').style.display = '';
                    }

                    function handleFieldsContinue() {
                        var ff = validateFormFields();
                        if (!ff.valid) {
                            updateSignSubmitState();
                            return;
                        }
                        collectedFormFieldJson = JSON.stringify(ff.values);
                        formFieldsCollected = true;
                        document.getElementById('btn-sign-submit').textContent = 'Sign';
                        closeSignModal();
                        var fn = afterFieldsAction;
                        afterFieldsAction = null;
                        if (fn) fn();
                    }

                    // ===== SIGNING MODAL =====
                    function wireSignModal() {
                        document.getElementById('modal-close').addEventListener('click', closeSignModal);
                        document.getElementById('modal-cancel').addEventListener('click', closeSignModal);
                        document
                            .getElementById('modal-consent-checkbox')
                            .addEventListener('change', updateSignSubmitState);
                        document
                            .getElementById('attachments-reviewed-checkbox')
                            .addEventListener('change', updateSignSubmitState);
                        document.getElementById('modal-typed-name').addEventListener('input', updateSignSubmitState);
                        // Native date inputs (DatePick) fire 'change' on selection, not always 'input'.
                        document.getElementById('modal-typed-name').addEventListener('change', updateSignSubmitState);
                        document.getElementById('btn-sign-submit').addEventListener('click', handleSignSubmit);
                        // "Save & Next" — guided per-field capture only (shown in spot mode).
                        document.getElementById('btn-sign-submit-next').addEventListener('click', function () {
                            handleSpotSubmit(true);
                        });
                        DrawPad.init();
                    }

                    function openSignModal() {
                        // Form fields first, then the single typed-name + consent modal.
                        if (hasPendingFormFields()) {
                            openFormFieldsStep(openSignModal);
                            return;
                        }
                        modalMode = 'pdf';
                        document.getElementById('modal-draw-group').style.display = 'none';
                        // Re-show name + consent (the form-fields step hides them).
                        document.getElementById('modal-typed-name').parentNode.style.display = '';
                        document.getElementById('modal-consent-checkbox').parentNode.style.display = '';
                        showAttachmentsReviewed(false);
                        document.querySelector('#sign-modal .modal-header h2').textContent = 'Sign Document';
                        document.querySelector('#sign-modal .modal-subtitle').textContent =
                            'Confirm your name and consent to sign electronically.';
                        document.getElementById('btn-sign-submit').textContent = 'Sign';
                        // Prefill the confirmed name from validateToken.signerName.
                        var nameInput = document.getElementById('modal-typed-name');
                        nameInput.value = signerData && signerData.signerName ? signerData.signerName : '';
                        document.getElementById('modal-consent-checkbox').checked = false;
                        // Form fields were collected up front — don't ask again here.
                        hideFormFields();
                        showModalMsg('', 'info');
                        updateSignSubmitState();
                        document.getElementById('sign-modal').style.display = '';
                        setTimeout(function () {
                            nameInput.focus();
                        }, 50);
                    }

                    function closeSignModal() {
                        document.getElementById('sign-modal').style.display = 'none';
                    }

                    function updateSignSubmitState() {
                        var nameVal = document.getElementById('modal-typed-name').value.trim();
                        var consentVal = document.getElementById('modal-consent-checkbox').checked;
                        var btn = document.getElementById('btn-sign-submit');
                        if (modalMode === 'fields') {
                            // Up-front form-field step: enable Continue once required fields
                            // are valid (#161). No name/consent here.
                            btn.disabled = !validateFormFields().valid;
                        } else if (modalMode === 'spot') {
                            // Per-spot capture: a typed value OR a drawn signature is enough
                            // (Date types pre-enable in openPlacementCapture). Both the "Save" and
                            // "Save & Next" buttons share the same enablement.
                            var ready = !!(nameVal || DrawPad.hasInk());
                            btn.disabled = !ready;
                            document.getElementById('btn-sign-submit-next').disabled = !ready;
                        } else if (modalMode === 'final') {
                            // Guided final step: every field was already signed individually, so
                            // only the consent affirmation is required (the name comes from the
                            // signer record — we don't re-ask for it). #412: plus the review
                            // confirmation when the request has attached documents.
                            btn.disabled = !consentVal || !attachmentsReviewedOk();
                        } else {
                            // 'pdf' legacy single-modal flow: name + consent (the typed name IS
                            // the signature). Signer form fields (#161) collected up front.
                            btn.disabled = !(nameVal && consentVal);
                        }
                    }

                    // Sync guided spot signed-state from a server placement list.
                    // The server is the source of truth for the stamped value (e.g.
                    // Date types are filled server-side), so render from it.
                    function syncGuidedFromPlacements(placements) {
                        if (!guided || !placements) return;
                        var byId = {};
                        for (var i = 0; i < placements.length; i++) {
                            byId[placements[i].id] = placements[i];
                        }
                        guided.spots.forEach(function (spot) {
                            var p = byId[spot.placement.id];
                            if (p && p.status === 'Signed' && !spot.signed) {
                                spot.signed = true;
                                spot.placement.signedValue = p.signedValue;
                                // Show the drawn signature on the chip if one was captured;
                                // otherwise the typed value / server-stamped text.
                                if (spot.imageData) {
                                    renderSignedChipImage(spot.chip, spot.imageData);
                                } else {
                                    renderSignedChip(spot.chip, p.signedValue, spot.placement.type);
                                }
                            }
                        });
                    }

                    function handleSignSubmit() {
                        if (modalMode === 'spot') {
                            // btn-sign-submit is the "Save" action (scroll-only advance).
                            handleSpotSubmit(false);
                            return;
                        }
                        if (modalMode === 'final') {
                            handleFinalSubmit();
                            return;
                        }
                        if (modalMode === 'fields') {
                            handleFieldsContinue();
                            return;
                        }

                        var typedName = document.getElementById('modal-typed-name').value.trim();
                        var consentGiven = document.getElementById('modal-consent-checkbox').checked;
                        if (!typedName || !consentGiven) return;

                        var btn = document.getElementById('btn-sign-submit');
                        btn.disabled = true;
                        btn.textContent = 'Signing...';

                        // Capture IP (browser fetch above; server resolveClientIp falls back).
                        var userAgent = navigator.userAgent || 'Unknown';

                        Visualforce.remoting.Manager.invokeAction(
                            '{!$RemoteAction.DocGenSignatureController.savePdfSignature}',
                            token,
                            typedName,
                            consentGiven,
                            capturedIp,
                            userAgent,
                            collectedFormFieldJson,
                            function (result, event) {
                                btn.disabled = false;
                                btn.textContent = 'Sign';
                                if (!event.status || !result || result.success === false) {
                                    showModalMsg(
                                        (result && result.message) || event.message || 'Unable to complete signing.',
                                        'error'
                                    );
                                    return;
                                }
                                closeSignModal();
                                if (result.isComplete) {
                                    showState('success');
                                } else {
                                    var rem = result.remaining || 0;
                                    document.getElementById('waiting-message').textContent =
                                        'Your signature has been recorded. Waiting for ' +
                                        rem +
                                        ' more signer' +
                                        (rem > 1 ? 's' : '') +
                                        ' to complete.';
                                    showState('waiting');
                                }
                            },
                            { escape: false, buffer: false, timeout: 120000 }
                        );
                    }

                    // Format a native date input's ISO value (yyyy-mm-dd) like the auto Date stamp
                    // ("January 1, 2026"). Build a LOCAL date from the parts — new Date('yyyy-mm-dd')
                    // parses as UTC midnight and can render the prior day in negative timezones.
                    function formatPickedDate(iso) {
                        if (!iso) return '';
                        var p = String(iso).split('-');
                        if (p.length !== 3) return iso; // not ISO — pass through defensively
                        var d = new Date(Number(p[0]), Number(p[1]) - 1, Number(p[2]));
                        if (isNaN(d.getTime())) return iso;
                        return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
                    }

                    // Guided: persist one placement, mark its chip signed, advance.
                    // openNext: false = "Save" (scroll to next field, don't open it);
                    //           true  = "Save & Next" (save and open the next field's modal).
                    function handleSpotSubmit(openNext) {
                        if (!activeSpot) return;
                        var type = activeSpot.placement.type;
                        var typed = document.getElementById('modal-typed-name').value.trim();
                        var drew = (type === 'Full' || type === 'Initials') && DrawPad.hasInk();

                        if (type !== 'Date' && !drew && !typed) return;

                        // Capture client-side for the final composite; mark signed server-side
                        // with a value (drawn fields store a marker — the image lives in the
                        // composited PDF, not in the 255-char Signed_Value__c field).
                        var serverValue;
                        if (type === 'Date') {
                            activeSpot.imageData = null;
                            activeSpot.value = '';
                            serverValue = '';
                        } else if (drew) {
                            activeSpot.imageData = DrawPad.toPng();
                            activeSpot.value = null;
                            serverValue = 'Signed (drawn)';
                        } else {
                            activeSpot.imageData = null;
                            // DatePick comes from a native date input as ISO (yyyy-mm-dd); stamp it
                            // in the same readable form as the auto Date type ("Month D, YYYY").
                            var captured = type === 'DatePick' ? formatPickedDate(typed) : typed;
                            activeSpot.value = captured;
                            serverValue = captured;
                        }

                        var saveBtn = document.getElementById('btn-sign-submit');
                        var nextBtn = document.getElementById('btn-sign-submit-next');
                        var pressed = openNext ? nextBtn : saveBtn;
                        var pressedLabel = pressed.textContent;
                        saveBtn.disabled = true;
                        nextBtn.disabled = true;
                        pressed.textContent = 'Saving...';

                        Visualforce.remoting.Manager.invokeAction(
                            '{!$RemoteAction.DocGenSignatureController.signPlacement}',
                            token,
                            activeSpot.placement.id,
                            serverValue,
                            function (placements, event) {
                                saveBtn.disabled = false;
                                nextBtn.disabled = false;
                                pressed.textContent = pressedLabel;
                                if (!event.status) {
                                    showModalMsg('Save failed: ' + (event.message || 'Unknown error'), 'error');
                                    return;
                                }
                                syncGuidedFromPlacements(placements);
                                closeSignModal();
                                refreshGuidedStatus();
                                // Walk to the next pending field at the pace the signer chose:
                                // "Save & Next" opens the next field's modal (or auto-fills a Date
                                // and continues, or opens final submit); "Save" only scrolls to
                                // and highlights the next field so they can read before signing.
                                advanceGuided(openNext);
                            },
                            { escape: false }
                        );
                    }

                    // Guided: all spots done — capture consent + finalize the signature.
                    function handleFinalSubmit() {
                        var consentGiven = document.getElementById('modal-consent-checkbox').checked;
                        if (!consentGiven || !attachmentsReviewedOk()) return;
                        // Name is no longer re-typed here (#183) — use the name already on the
                        // signer record (what pre-filled each field). Fall back to the input only
                        // if, somehow, the record has no name.
                        var typedName =
                            signerData && signerData.signerName
                                ? signerData.signerName
                                : document.getElementById('modal-typed-name').value.trim();
                        // Signer form fields (#161) were collected up front, before signing.
                        var formFieldJson = collectedFormFieldJson;

                        var btn = document.getElementById('btn-sign-submit');
                        btn.disabled = true;
                        btn.textContent = 'Submitting...';
                        var userAgent = navigator.userAgent || 'Unknown';

                        // If the signer produced any mark this session — drawn OR typed —
                        // the authoritative PDF is built in-browser (pdf-lib composite)
                        // and posted to saveCompositedSignedPdf. Typed marks must take
                        // this path too: the saveSignature server re-render regenerates
                        // the document and flattens every prior signer's drawn ink to
                        // text, so in a multi-signer chain a typed signer would destroy
                        // an earlier drawn signature. The server path below is only the
                        // fallback when the source PDF couldn't be read or a returning
                        // signer's session marks are gone.
                        var hasClientMarks = false;
                        if (guided && guided.spots) {
                            for (var i = 0; i < guided.spots.length; i++) {
                                if (guided.spots[i].imageData || guided.spots[i].value) {
                                    hasClientMarks = true;
                                    break;
                                }
                            }
                        }
                        if (hasClientMarks && sourcePdfBase64) {
                            compositeAndFinalize(typedName, consentGiven, btn, formFieldJson)
                                .then(function (result) {
                                    btn.disabled = false;
                                    btn.textContent = 'Sign';
                                    closeSignModal();
                                    if (result.isComplete) {
                                        showState('success');
                                    } else {
                                        var rem = result.remaining || 0;
                                        document.getElementById('waiting-message').textContent =
                                            'Your signature has been recorded. Waiting for ' +
                                            rem +
                                            ' more signer' +
                                            (rem > 1 ? 's' : '') +
                                            ' to complete.';
                                        showState('waiting');
                                    }
                                })
                                .catch(function (err) {
                                    btn.disabled = false;
                                    btn.textContent = 'Sign';
                                    showModalMsg(
                                        err && err.message ? err.message : 'Unable to complete signing.',
                                        'error'
                                    );
                                });
                            return;
                        }

                        Visualforce.remoting.Manager.invokeAction(
                            '{!$RemoteAction.DocGenSignatureController.saveSignature}',
                            token,
                            typedName,
                            consentGiven,
                            capturedIp,
                            userAgent,
                            formFieldJson,
                            function (result, event) {
                                btn.disabled = false;
                                btn.textContent = 'Sign';
                                if (!event.status || !result || result.success === false) {
                                    showModalMsg(
                                        (result && result.message) || event.message || 'Unable to complete signing.',
                                        'error'
                                    );
                                    return;
                                }
                                closeSignModal();
                                if (result.isComplete) {
                                    showState('success');
                                } else {
                                    var rem = result.remaining || 0;
                                    document.getElementById('waiting-message').textContent =
                                        'Your signature has been recorded. Waiting for ' +
                                        rem +
                                        ' more signer' +
                                        (rem > 1 ? 's' : '') +
                                        ' to complete.';
                                    showState('waiting');
                                }
                            },
                            { escape: false, buffer: false, timeout: 120000 }
                        );
                    }

                    // ===== DECLINE =====
                    // #412 — what the decline covers. Declining isn't gated: a signer may stop at the
                    // first problem. But they see which attached documents they haven't opened before
                    // they confirm, and the sender's decline notice lists them too.
                    function showDeclineReview() {
                        var box = document.getElementById('decline-review');
                        var list = document.getElementById('decline-review-list');
                        var warning = document.getElementById('decline-review-warning');
                        var left = hasAttachments() ? unopenedAttachments().length : 0;
                        box.style.display = hasAttachments() ? '' : 'none';
                        while (list.firstChild) list.removeChild(list.firstChild);
                        docOrder.forEach(function (entry) {
                            if (entry === 'form') return;
                            var li = document.createElement('li');
                            var name = document.createElement('span');
                            name.className = 'dr-name';
                            name.textContent =
                                (entry.title || 'Document') + (entry.version ? ' (v' + entry.version + ')' : '');
                            var state = document.createElement('span');
                            state.className = 'dr-state' + (entry.viewedAt ? '' : ' unopened');
                            state.textContent = !entry.viewedAt
                                ? '○ Not opened'
                                : isMarkedUp(entry)
                                  ? '✎ Marked up'
                                  : '✓ Opened';
                            li.appendChild(name);
                            li.appendChild(state);
                            list.appendChild(li);
                        });
                        warning.style.display = left ? '' : 'none';
                        warning.textContent = left ? declineWarning(left, attachments.length) : '';
                        document.getElementById('btn-decline-cancel').style.display = left ? 'none' : '';
                        document.getElementById('btn-decline-review').style.display = left ? '' : 'none';
                        document.getElementById('btn-decline-confirm').textContent = declineConfirmLabel();
                    }

                    function declineWarning(left, total) {
                        if (left < total) {
                            return (
                                "You haven't opened " +
                                left +
                                ' of the ' +
                                total +
                                ' attached documents, so your comments only cover the ones you opened. ' +
                                "The sender will see which ones you didn't open."
                            );
                        }
                        return total === 1
                            ? "You haven't opened the attached document. The sender will see that you declined without opening it."
                            : "You haven't opened any of the " +
                                  total +
                                  ' attached documents. The sender will see that you declined without opening them.';
                    }

                    function declineConfirmLabel() {
                        return hasAttachments() && unopenedAttachments().length ? 'Decline anyway' : 'Confirm Decline';
                    }

                    function handleDecline() {
                        var reason = document.getElementById('decline-reason').value.trim();
                        var btn = document.getElementById('btn-decline-confirm');
                        btn.disabled = true;
                        btn.textContent = 'Declining...';

                        var ua = navigator.userAgent || 'Unknown';
                        // #412 M2 — the markups are saved to the record before the decline.
                        document.getElementById('decline-markup-error').style.display = 'none';
                        var note = document.getElementById('decline-markup-note');
                        uploadMarkups(function (a, n, of) {
                            btn.textContent = 'Saving markups\u2026';
                            note.style.display = '';
                            if (!a) {
                                note.textContent = 'Saving your markups\u2026 Please keep this page open.';
                                return;
                            }
                            note.textContent =
                                'Saving your markup on \u201C' +
                                (a.title || 'a document') +
                                '\u201D (' +
                                n +
                                ' of ' +
                                of +
                                ')\u2026 Please keep this page open.';
                        })
                            .then(function () {
                                btn.textContent = 'Declining...';
                                sendDecline(reason, btn, ua);
                            })
                            .catch(function (err) {
                                btn.disabled = false;
                                btn.textContent = declineConfirmLabel();
                                var errEl = document.getElementById('decline-markup-error');
                                errEl.textContent =
                                    err && err.userMessage
                                        ? err.userMessage
                                        : 'Your markups could not be saved. Please try again.';
                                errEl.style.display = '';
                            });
                    }

                    function sendDecline(reason, btn, ua) {
                        Visualforce.remoting.Manager.invokeAction(
                            '{!$RemoteAction.DocGenSignatureController.declineSignature}',
                            token,
                            reason,
                            capturedIp,
                            ua,
                            function (result, event) {
                                btn.disabled = false;
                                btn.textContent = declineConfirmLabel();
                                if (event.status && result && result.success) {
                                    document.getElementById('error-message').textContent =
                                        'You have declined this signature request.';
                                    document.querySelector('.error-card h2').textContent = 'Request Declined';
                                    document.querySelector('.error-icon').textContent = '✖';
                                    showState('error');
                                } else {
                                    alert(result ? result.message : 'Failed to decline. Please try again.');
                                }
                            },
                            { escape: false }
                        );
                    }
                })();
            </script>
        </body>
    </html>
</apex:page>
